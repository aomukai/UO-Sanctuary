+// SPDX-License-Identifier: BSD-2-Clause
+using ClassicUO.Game.UI.Controls;
+namespace ClassicUO.Game.UI.Gumps;
+
+internal sealed class CombatActionsGump : Gump
+{
+    private readonly Label _actions;
+    private string _caption;
+    public CombatActionsGump(World world) : base(world, 0, 0)
+    {
+        X = 8;
+        Y = 40;
+        CanMove = false;
+        CanCloseWithRightClick = false;
+        AcceptMouseInput = false;
+        Add(_actions = new Label(ClassCombatClient.Caption, true, 0x0481));
+    }
+    public override void Update()
+    {
+        if (_caption != ClassCombatClient.Caption)
+        {
+            _caption = ClassCombatClient.Caption;
+            _actions.Text = _caption;
+        }
+        base.Update();
+    }
+}
