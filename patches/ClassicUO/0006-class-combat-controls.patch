diff --git a/src/ClassicUO.Client/Game/ClassCombatClient.cs b/src/ClassicUO.Client/Game/ClassCombatClient.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/ClassCombatClient.cs
@@ -0,0 +1,505 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using System;
+using System.Collections.Generic;
+using ClassicUO.Configuration;
+using ClassicUO.Game.GameObjects;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.Scenes;
+using ClassicUO.Game.UI.Gumps;
+using ClassicUO.Input;
+using ClassicUO.IO;
+using ClassicUO.Network;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class ClassCombatClient
+{
+    private static readonly HashSet<uint> _hostiles = new();
+    private static bool _queried, _pursuing;
+    private static Mobile _selectionFallback;
+    private static uint _sequence, _target, _lastPath;
+    private static ushort _pathX, _pathY;
+    private static bool _rightHeld;
+    private static uint _heldUnit, _nextHoldUpdate;
+    private static CombatAbility _heldAbility;
+    private static bool _groundHeld, _groundGesture;
+    private static bool _attackHeld, _attackGesture;
+    private static uint _nextAttackUpdate;
+    private static CombatAbility _attackAbility;
+    public static bool AttackGesture => _attackGesture;
+    private static uint _nextGroundUpdate;
+    private static int _groundX, _groundY, _groundZ;
+    public static bool GroundGesture => _groundGesture;
+    public static bool Enabled { get; private set; }
+    public static bool Running => ProfileManager.CurrentProfile.DiabloRun;
+    public static void ToggleMovement()
+    {
+        if (Enabled)
+        {
+            ProfileManager.CurrentProfile.DiabloRun = !Running;
+            UpdateCaption();
+            Send(CombatRequest.MovementMode, serial: Running ? 1u : 0u);
+        }
+    }
+    public static CombatAbility Left { get; private set; }
+    public static CombatAbility Right { get; private set; }
+    public static int TeethRank { get; private set; }
+    public static string Caption { get; private set; } = string.Empty;
+
+    public static void Reset()
+    {
+        Enabled = _queried = _pursuing = _rightHeld = false;
+        _heldUnit = 0;
+        _groundHeld = _groundGesture = false;
+        _attackHeld = _attackGesture = false;
+        _sequence = _target = 0;
+        _lastPath = Time.Ticks - 500;
+        _hostiles.Clear();
+        _selectionFallback = null;
+    }
+    public static bool Hostile(Mobile target) => target != null && !target.IsDead && !target.IsDestroyed && _hostiles.Contains(target.Serial);
+
+    public static void BeginSelection() => _selectionFallback = null;
+
+    public static void ConsiderSelectionFallback(Mobile mobile, Microsoft.Xna.Framework.Rectangle bounds)
+    {
+        if (!Enabled || !Hostile(mobile) || mobile.World.TargetManager.IsTargeting
+            || mobile.World.CustomHouseManager != null || Client.Game.UO.GameCursor.ItemHold.Enabled
+            || bounds.Width <= 0 || bounds.Height <= 0)
+        {
+            return;
+        }
+        bounds.Inflate(3, 3);
+        if (!bounds.Contains(SelectedObject.TranslatedMousePositionByViewport))
+        {
+            return;
+        }
+        var previous = _selectionFallback;
+        var depth = mobile.CalculateDepthZ();
+        if (previous == null || depth > previous.CalculateDepthZ()
+            || depth == previous.CalculateDepthZ() && mobile.Serial < previous.Serial)
+        {
+            _selectionFallback = mobile;
+        }
+    }
+
+    public static void FinishSelection()
+    {
+        var fallback = _selectionFallback;
+        _selectionFallback = null;
+        // The normal pixel pass wins for every creature and usable item. Filled
+        // bodies only replace ground/background pixels, with normal wall occlusion.
+        if (!UIManager.IsMouseOverWorld || fallback == null || SelectedObject.Object is Mobile or Item)
+        {
+            return;
+        }
+        if (SelectedObject.Object is not GameObject picked || fallback.CalculateDepthZ() >= picked.CalculateDepthZ())
+        {
+            SelectedObject.Object = fallback;
+        }
+    }
+
+    public static void Update(World world)
+    {
+        if (!_queried)
+        {
+            _queried = true;
+            Send(CombatRequest.Hello);
+            Send(CombatRequest.MovementMode, serial: Running ? 1u : 0u);
+        }
+        if (!Enabled)
+        {
+            return;
+        }
+        var hud = UIManager.GetGump<CombatActionsGump>();
+        if (hud == null)
+        {
+            UIManager.Add(new CombatActionsGump(world));
+        }
+        UpdateAttackHold(world);
+        UpdateRightHold(world);
+        UpdateGroundHold(world);
+        if (Keyboard.Shift)
+        {
+            world.Player.Pathfinder.StopAutoWalk();
+            return;
+        }
+        if (_target == 0)
+        {
+            return;
+        }
+        var enemy = world.Mobiles.Get(_target);
+        if (!Hostile(enemy) || world.Player.IsDead || enemy.Distance > CombatProtocol.SightRange)
+        {
+            Stop(world);
+            return;
+        }
+        int range = Left == CombatAbility.Teeth ? CombatProtocol.TeethRange : CombatProtocol.BasicRange;
+        if (enemy.Distance <= range && Math.Abs(enemy.Z - world.Player.Z) < 16)
+        {
+            if (_pursuing)
+            {
+                world.Player.Pathfinder.StopAutoWalk();
+                _pursuing = false;
+            }
+            return;
+        }
+        if (unchecked((int)(Time.Ticks - _lastPath)) >= 500
+            && (!world.Player.Pathfinder.AutoWalking || enemy.X != _pathX || enemy.Y != _pathY))
+        {
+            _lastPath = Time.Ticks;
+            _pathX = enemy.X;
+            _pathY = enemy.Y;
+            _pursuing = world.Player.Pathfinder.WalkTo(enemy.X, enemy.Y, enemy.Z, range);
+        }
+    }
+    public static void Receive(World world, ref StackDataReader reader)
+    {
+        if (!world.InGame || reader.Remaining < 14 || reader.ReadUInt8() != CombatProtocol.Version)
+        {
+            return;
+        }
+        var ack = reader.ReadUInt32BE();
+        Left = (CombatAbility)reader.ReadUInt8();
+        Right = (CombatAbility)reader.ReadUInt8();
+        TeethRank = reader.ReadUInt8();
+        var target = reader.ReadUInt32BE();
+        var count = reader.ReadUInt8();
+        var running = reader.ReadUInt8() != 0;
+        if (count > CombatProtocol.MaxHostiles || reader.Remaining != count * 4)
+        {
+            return;
+        }
+        Enabled = true;
+        _hostiles.Clear();
+        for (var i = 0; i < count; i++)
+        {
+            _hostiles.Add(reader.ReadUInt32BE());
+        }
+        if (unchecked((int)(ack - _sequence)) >= 0)
+        {
+            ProfileManager.CurrentProfile.DiabloRun = running;
+            if (_target != target && _pursuing)
+            {
+                world.Player.Pathfinder.StopAutoWalk();
+                _pursuing = false;
+            }
+            _target = target;
+        }
+        UpdateCaption();
+    }
+    private static void UpdateCaption()
+    {
+        var leftName = Left == CombatAbility.BasicAttack ? "Attack" : Left.ToString();
+        var rightName = Right == CombatAbility.Teeth
+            ? TeethRank > 0 ? $"Teeth {TeethRank}" : "Teeth (unavailable)"
+            : Right.ToString();
+        Caption = $"Move: {(Running ? "Run" : "Walk")} (Tab)    Left: {leftName}    Right: {rightName}";
+    }
+    public static void Select(World world, Mobile target)
+    {
+        _rightHeld = _groundHeld = _attackHeld = false;
+        StopMovement(world);
+        _target = 0;
+        _lastPath = Time.Ticks - 500;
+        if (Hostile(target))
+        {
+            world.TargetManager.LastAttack = target.Serial;
+            Send(CombatRequest.Attack, target.Serial);
+        }
+    }
+    private static void StopMovement(World world)
+    {
+        world.Player.Pathfinder.StopAutoWalk();
+        _pursuing = false;
+    }
+    public static void Stop(World world)
+    {
+        _rightHeld = _groundHeld = _attackHeld = false;
+        StopMovement(world);
+        _target = 0;
+        world.TargetManager.LastAttack = 0;
+        Send(CombatRequest.Stop);
+    }
+    public static bool LeftClick(World world)
+    {
+        if (!Enabled || UIManager.IsDragging || Client.Game.UO.GameCursor.ItemHold.Enabled
+            || world.TargetManager.IsTargeting || world.CustomHouseManager != null)
+        {
+            return false;
+        }
+        var obj = SelectedObject.Object;
+        if (obj is Mobile mobile)
+        {
+            if (Hostile(mobile))
+            {
+                Select(world, mobile);
+                return true;
+            }
+            Stop(world);
+            // Keep ordinary single/double click and context-menu interaction for friendlies.
+            return false;
+        }
+        if (obj is Land or Static or Multi)
+        {
+            Stop(world);
+            if (!Keyboard.Shift && obj is GameObject point)
+            {
+                world.Player.Pathfinder.WalkTo(point.X, point.Y, point.Z, 0);
+            }
+            return true;
+        }
+        return false;
+    }
+    public static bool BeginAttackHold(World world)
+    {
+        if (!Enabled || !Keyboard.Shift || !UIManager.IsMouseOverWorld || UIManager.IsDragging
+            || world.Player.IsDead || world.TargetManager.IsTargeting
+            || Client.Game.UO.GameCursor.ItemHold.Enabled || world.CustomHouseManager != null)
+        {
+            return false;
+        }
+        Stop(world);
+        _attackHeld = _attackGesture = true;
+        _attackAbility = Left;
+        _nextAttackUpdate = Time.Ticks;
+        UpdateAttackHold(world);
+        return true;
+    }
+    public static bool FinishAttackHold()
+    {
+        bool gesture = _attackGesture;
+        _attackGesture = false;
+        EndAttackHold();
+        return gesture;
+    }
+    private static void EndAttackHold()
+    {
+        if (_attackHeld)
+        {
+            _attackHeld = false;
+            Send(CombatRequest.ReleaseAttack);
+        }
+    }
+    private static void UpdateAttackHold(World world)
+    {
+        if (!_attackHeld)
+        {
+            return;
+        }
+        if (!Mouse.LButtonPressed || !Keyboard.Shift || !Client.Game.IsActive || !UIManager.IsMouseOverWorld
+            || world.Player.IsDead || world.TargetManager.IsTargeting || Client.Game.UO.GameCursor.ItemHold.Enabled
+            || world.CustomHouseManager != null || UIManager.IsDragging || Left != _attackAbility)
+        {
+            // Keep consuming this gesture until mouse-up, even if Shift is released
+            // first. It must never fall through into a chase or a ground path.
+            EndAttackHold();
+            return;
+        }
+        StopMovement(world);
+        if (unchecked((int)(Time.Ticks - _nextAttackUpdate)) >= 0)
+        {
+            _nextAttackUpdate = Time.Ticks + CombatProtocol.HoldHeartbeatMs;
+            if (SelectedObject.Object is Mobile enemy && Hostile(enemy))
+            {
+                Send(CombatRequest.HoldAttack, enemy.Serial, _attackAbility, enemy.X, enemy.Y, enemy.Z);
+            }
+            else
+            {
+                SendPointAim(world, CombatRequest.HoldAttack, _attackAbility);
+            }
+        }
+    }
+    public static bool BeginGroundHold(World world)
+    {
+        if (!Enabled || !UIManager.IsMouseOverWorld || world.TargetManager.IsTargeting
+            || Client.Game.UO.GameCursor.ItemHold.Enabled || world.CustomHouseManager != null
+            || SelectedObject.Object is not (Land or Static or Multi))
+        {
+            return false;
+        }
+        Stop(world);
+        _groundHeld = _groundGesture = true;
+        _groundX = _groundY = -1;
+        _nextGroundUpdate = Time.Ticks;
+        UpdateGroundHold(world);
+        return true;
+    }
+    public static bool FinishGroundHold()
+    {
+        bool gesture = _groundGesture;
+        _groundHeld = _groundGesture = false;
+        return gesture;
+    }
+    private static void UpdateGroundHold(World world)
+    {
+        if (!_groundHeld)
+        {
+            return;
+        }
+        if (!Mouse.LButtonPressed)
+        {
+            _groundHeld = false;
+            return;
+        }
+        if (!Client.Game.IsActive || !UIManager.IsMouseOverWorld || world.Player.IsDead
+            || world.TargetManager.IsTargeting || Client.Game.UO.GameCursor.ItemHold.Enabled)
+        {
+            _groundHeld = false;
+            StopMovement(world);
+            return;
+        }
+        if (Keyboard.Shift)
+        {
+            StopMovement(world);
+            return;
+        }
+        if (unchecked((int)(Time.Ticks - _nextGroundUpdate)) < 0
+            || SelectedObject.Object is not (Land or Static or Multi)
+            || SelectedObject.Object is not GameObject point)
+        {
+            return;
+        }
+        _nextGroundUpdate = Time.Ticks + CombatProtocol.HoldHeartbeatMs;
+        if (_groundX != point.X || _groundY != point.Y || _groundZ != point.Z || !world.Player.Pathfinder.AutoWalking)
+        {
+            _groundX = point.X;
+            _groundY = point.Y;
+            _groundZ = point.Z;
+            if (world.Player.X != point.X || world.Player.Y != point.Y || Math.Abs(world.Player.Z - point.Z) >= 16)
+            {
+                world.Player.Pathfinder.WalkTo(point.X, point.Y, point.Z, 0);
+            }
+        }
+    }
+    public static bool RightClick(World world)
+    {
+        if (!Enabled)
+        {
+            return false;
+        }
+        EndRightHold();
+        EndAttackHold();
+        if (world.TargetManager.IsTargeting)
+        {
+            world.TargetManager.CancelTarget();
+            return true;
+        }
+        if (Client.Game.UO.GameCursor.ItemHold.Enabled || world.CustomHouseManager != null
+            || Right == CombatAbility.None || Right == CombatAbility.Teeth && TeethRank == 0)
+        {
+            return true;
+        }
+        var obj = SelectedObject.Object;
+        if (obj is Mobile mobile && !Hostile(mobile))
+        {
+            Stop(world);
+            return true;
+        }
+        _groundHeld = false;
+        StopMovement(world);
+        _target = 0;
+        _rightHeld = true;
+        _heldAbility = Right;
+        _heldUnit = obj is Mobile enemy ? enemy.Serial : 0;
+        SendHeldAim(world);
+        _nextHoldUpdate = Time.Ticks + CombatProtocol.HoldHeartbeatMs;
+        return true;
+    }
+    public static void EndRightHold()
+    {
+        if (_rightHeld)
+        {
+            _rightHeld = false;
+            _heldUnit = 0;
+            Send(CombatRequest.ReleaseCast);
+        }
+    }
+    private static void UpdateRightHold(World world)
+    {
+        if (!_rightHeld)
+        {
+            return;
+        }
+        if (!Mouse.RButtonPressed || !Client.Game.IsActive || !UIManager.IsMouseOverWorld
+            || world.Player.IsDead || world.TargetManager.IsTargeting || Client.Game.UO.GameCursor.ItemHold.Enabled
+            || Right != _heldAbility || Right == CombatAbility.Teeth && TeethRank == 0)
+        {
+            EndRightHold();
+            return;
+        }
+        if (unchecked((int)(Time.Ticks - _nextHoldUpdate)) >= 0)
+        {
+            _nextHoldUpdate = Time.Ticks + CombatProtocol.HoldHeartbeatMs;
+            SendHeldAim(world);
+        }
+    }
+    private static void SendHeldAim(World world)
+    {
+        if (_heldUnit != 0)
+        {
+            var unit = world.Mobiles.Get(_heldUnit);
+            if (!Hostile(unit))
+            {
+                EndRightHold();
+                return;
+            }
+            Send(CombatRequest.HoldCast, unit.Serial, _heldAbility, unit.X, unit.Y, unit.Z);
+            return;
+        }
+        if (SelectedObject.Object is Mobile friendly && !Hostile(friendly))
+        {
+            EndRightHold();
+            return;
+        }
+        SendPointAim(world, CombatRequest.HoldCast, _heldAbility);
+    }
+    private static void SendPointAim(World world, CombatRequest action, CombatAbility ability)
+    {
+        if (SelectedObject.Object is GameObject point)
+        {
+            Send(action, 0, ability, point.X, point.Y, point.Z);
+            return;
+        }
+        // Empty/undrawn world pixels still specify a direction in the isometric plane.
+        var camera = Client.Game.Scene.Camera;
+        var mouse = camera.MouseToWorldPosition();
+        var center = camera.ScreenToWorld(new Microsoft.Xna.Framework.Point(camera.Bounds.Width / 2, camera.Bounds.Height / 2));
+        var dx = mouse.X - center.X;
+        var dy = mouse.Y - center.Y;
+        var x = Math.Clamp(world.Player.X + (dx + dy) / 44, 0, ushort.MaxValue);
+        var y = Math.Clamp(world.Player.Y + (dy - dx) / 44, 0, ushort.MaxValue);
+        Send(action, 0, ability, (ushort)x, (ushort)y, world.Player.Z);
+    }
+    private static void Send(CombatRequest action, uint serial = 0, CombatAbility ability = CombatAbility.None,
+        ushort x = 0, ushort y = 0, sbyte z = 0)
+    {
+        int length = 11 + (action == CombatRequest.Attack ? 4 : action is CombatRequest.Cast or CombatRequest.HoldCast or CombatRequest.HoldAttack ? 10 : action == CombatRequest.MovementMode ? 1 : 0);
+        var writer = new StackDataWriter(length);
+        writer.WriteUInt8(0xBF);
+        writer.WriteUInt16BE((ushort)length);
+        writer.WriteUInt16BE(CombatProtocol.SubCommand);
+        writer.WriteUInt8(CombatProtocol.Version);
+        writer.WriteUInt8((byte)action);
+        writer.WriteUInt32BE(++_sequence);
+        if (action == CombatRequest.MovementMode)
+        {
+            writer.WriteUInt8((byte)serial);
+        }
+        else if (action == CombatRequest.Attack)
+        {
+            writer.WriteUInt32BE(serial);
+        }
+        else if (action is CombatRequest.Cast or CombatRequest.HoldCast or CombatRequest.HoldAttack)
+        {
+            writer.WriteUInt8((byte)ability);
+            writer.WriteUInt32BE(serial);
+            writer.WriteUInt16BE(x);
+            writer.WriteUInt16BE(y);
+            writer.WriteUInt8((byte)z);
+        }
+        NetClient.Socket.Send(writer.BufferWritten);
+        writer.Dispose();
+    }
+}
