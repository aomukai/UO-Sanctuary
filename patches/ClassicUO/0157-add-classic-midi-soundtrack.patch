+        private UOMusic GetClassicMusic(int index)
+        {
+            var files = Client.Game.UO.FileManager;
+            if (!Settings.GlobalSettings.SanctuaryClassicMidi || !files.Sounds.TryGetMusicData(index, out string name, out bool loop))
+                return null;
+
+            if (_classicMusic.TryGetValue(index, out UOMusic track))
+                return track;
+
+            string path = files.GetUOFilePath($"Music/Classic/{index}.mp3");
+            return File.Exists(path) ? _classicMusic[index] = new UOMusic(index, name, loop, path) : null;
+        }
