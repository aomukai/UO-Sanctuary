diff --git a/src/ClassicUO.Client/Game/UI/Gumps/TalentClickAreas.cs b/src/ClassicUO.Client/Game/UI/Gumps/TalentClickAreas.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/UI/Gumps/TalentClickAreas.cs
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using System.Collections.Generic;
+using ClassicUO.Game.UI.Controls;
+using ClassicUO.Input;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal static class TalentClickAreas
+{
+    public static void Attach(Gump gump)
+    {
+        if (gump.ServerSerial != Sanctuary.ClassGumpProtocol.Talents)
+        {
+            return;
+        }
+        // Overlay after parsing so the HTML labels cannot intercept card clicks.
+        var buttons = new List<Button>();
+        foreach (var child in gump.Children)
+        {
+            if (child is Button button)
+            {
+                buttons.Add(button);
+            }
+        }
+        foreach (var button in buttons)
+        {
+            int id = button.ButtonID;
+            HitBox area;
+            if (id is >= 100 and < 110)
+            {
+                area = new HitBox(button.X - 3, button.Y - 28, 114, 46, alpha: 0.12f);
+            }
+            else if (id is >= 1000 and < 1010)
+            {
+                area = new HitBox(button.X, button.Y - 3, 188, 30, "Learn this skill for one point", 0.12f);
+            }
+            else
+            {
+                continue;
+            }
+            area.MouseUp += (_, e) =>
+            {
+                if (e.Button == MouseButtonType.Left)
+                {
+                    gump.OnButtonClick(id);
+                }
+            };
+            gump.Add(area, button.Page);
+        }
+    }
+}
