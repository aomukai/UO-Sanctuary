diff --git a/src/ClassicUO.Client/Game/ClassLootClient.cs b/src/ClassicUO.Client/Game/ClassLootClient.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/ClassLootClient.cs
@@ -0,0 +1,109 @@
+using System.Collections.Generic;
+using ClassicUO.Game.GameObjects;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.Gumps;
+using ClassicUO.IO;
+using ClassicUO.Network;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class ClassLootClient
+{
+    private static readonly HashSet<uint> _empty = new();
+    private static readonly List<uint> _items = new();
+    private static uint _nextPoll;
+    public static IReadOnlyList<uint> Items => _items;
+    public static bool Open { get; private set; }
+    public static void Reset()
+    {
+        _empty.Clear();
+        _items.Clear();
+        Open = false;
+        _nextPoll = Time.Ticks;
+    }
+    public static bool IsEmpty(uint serial) => ClassCombatClient.Enabled && _empty.Contains(serial);
+    public static void Update()
+    {
+        if (ClassCombatClient.Enabled && unchecked((int)(Time.Ticks - _nextPoll)) >= 0)
+        {
+            _nextPoll = Time.Ticks + LootProtocol.PollMs;
+            Send(LootRequest.Poll);
+        }
+    }
+    public static void OpenCorpse(uint serial) => Send(LootRequest.Open, serial);
+    public static void Take(uint serial) => Send(LootRequest.Take, serial);
+    public static void Close()
+    {
+        if (Open)
+        {
+            Open = false;
+            Send(LootRequest.Close);
+        }
+    }
+    public static void Receive(World world, ref StackDataReader reader)
+    {
+        if (!world.InGame || reader.Remaining < 9 || reader.ReadUInt8() != LootProtocol.Version)
+        {
+            return;
+        }
+        bool open = reader.ReadUInt8() != 0;
+        uint anchor = reader.ReadUInt32BE();
+        int count = reader.ReadUInt8();
+        int itemCount = reader.ReadUInt16BE();
+        if (count > LootProtocol.MaxCorpses || itemCount > LootProtocol.MaxItems || reader.Remaining != count * 5 + itemCount * 4)
+        {
+            return;
+        }
+        _empty.Clear();
+        for (var i = 0; i < count; i++)
+        {
+            var corpse = reader.ReadUInt32BE();
+            if (reader.ReadUInt8() != 0)
+            {
+                _empty.Add(corpse);
+            }
+        }
+        bool changed = _items.Count != itemCount;
+        var next = new List<uint>(itemCount);
+        for (var i = 0; i < itemCount; i++)
+        {
+            uint serial = reader.ReadUInt32BE();
+            changed |= i >= _items.Count || _items[i] != serial;
+            next.Add(serial);
+        }
+        _items.Clear();
+        _items.AddRange(next);
+        Open = open;
+        var gump = UIManager.GetGump<GridLootGump>(0);
+        if (Open)
+        {
+            if (gump == null && world.Items.Get(anchor) is Item)
+            {
+                gump = new GridLootGump(world, anchor, nearby: true);
+                UIManager.Add(gump);
+                changed = true;
+            }
+            if (changed)
+            {
+                gump?.RequestUpdateContents();
+            }
+        }
+        else
+        {
+            gump?.Dispose();
+        }
+    }
+    private static void Send(LootRequest action, uint serial = 0)
+    {
+        var writer = new StackDataWriter(11);
+        writer.WriteUInt8(0xBF);
+        writer.WriteUInt16BE(11);
+        writer.WriteUInt16BE(LootProtocol.SubCommand);
+        writer.WriteUInt8(LootProtocol.Version);
+        writer.WriteUInt8((byte)action);
+        writer.WriteUInt32BE(serial);
+        NetClient.Socket.Send(writer.BufferWritten);
+        writer.Dispose();
+    }
+}
