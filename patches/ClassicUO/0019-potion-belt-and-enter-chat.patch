diff --git a/src/ClassicUO.Client/Game/ClassBeltClient.cs b/src/ClassicUO.Client/Game/ClassBeltClient.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/ClassBeltClient.cs
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using System;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.Gumps;
+using ClassicUO.IO;
+using ClassicUO.Network;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class ClassBeltClient
+{
+    internal readonly record struct Cell(uint Serial, RestorationKind Kind, byte Tier, ushort Graphic, ushort Hue);
+    private static Cell[] _cells = new Cell[BeltProtocol.Cells];
+    private static uint _sequence, _nextPoll;
+    public static int Rows { get; private set; } = 1;
+    public static bool Ready { get; private set; }
+    public static bool Alive { get; private set; }
+    public static bool Expanded { get; private set; }
+    public static Cell Get(int cell) => _cells[cell];
+    public static bool Overflow
+    {
+        get
+        {
+            for (int i = Rows * 4; i < _cells.Length; i++)
+            {
+                if (_cells[i].Serial != 0) { return true; }
+            }
+            return false;
+        }
+    }
+    public static void Reset()
+    {
+        Array.Clear(_cells);
+        Rows = 1;
+        Ready = Alive = Expanded = false;
+        _sequence = 0;
+        _nextPoll = Time.Ticks;
+        UIManager.GetGump<PotionBeltGump>()?.Dispose();
+    }
+    public static void Update(World world)
+    {
+        if (!ClassCombatClient.Enabled) { return; }
+        if (UIManager.GetGump<PotionBeltGump>() == null) { UIManager.Add(new PotionBeltGump(world)); }
+        if (unchecked((int)(Time.Ticks - _nextPoll)) >= 0)
+        {
+            _nextPoll = Time.Ticks + BeltProtocol.PollMs;
+            Send(BeltRequest.Poll);
+        }
+    }
+    public static void Toggle()
+    {
+        Expanded = !Expanded;
+        UIManager.GetGump<PotionBeltGump>()?.RequestUpdateContents();
+    }
+    public static void Send(BeltRequest request, int cell = 0)
+    {
+        if (!ClassCombatClient.Enabled || cell < 0 || cell >= BeltProtocol.Cells) { return; }
+        var writer = new StackDataWriter(BeltProtocol.RequestLength);
+        writer.WriteUInt8(0xBF);
+        writer.WriteUInt16BE(BeltProtocol.RequestLength);
+        writer.WriteUInt16BE(BeltProtocol.SubCommand);
+        writer.WriteUInt8(BeltProtocol.Version);
+        writer.WriteUInt8((byte)request);
+        writer.WriteUInt8((byte)cell);
+        writer.WriteUInt32BE(++_sequence);
+        NetClient.Socket.Send(writer.BufferWritten);
+        writer.Dispose();
+    }
+    public static void Receive(World world, ref StackDataReader reader)
+    {
+        if (!world.InGame || reader.Remaining != BeltProtocol.StateLength - 5 || reader.ReadUInt8() != BeltProtocol.Version) { return; }
+        reader.ReadUInt32BE(); // Server acknowledgement; all state below is authoritative.
+        int rows = reader.ReadUInt8();
+        bool alive = reader.ReadUInt8() != 0;
+        if (rows is < 1 or > 4) { return; }
+        var cells = new Cell[BeltProtocol.Cells];
+        bool changed = !Ready || Rows != rows || Alive != alive;
+        for (int i = 0; i < cells.Length; i++)
+        {
+            cells[i] = new Cell(reader.ReadUInt32BE(), (RestorationKind)reader.ReadUInt8(), reader.ReadUInt8(),
+                reader.ReadUInt16BE(), reader.ReadUInt16BE());
+            changed |= cells[i] != _cells[i];
+        }
+        _cells = cells;
+        Rows = rows;
+        Alive = alive;
+        Ready = true;
+        if (changed) { UIManager.GetGump<PotionBeltGump>()?.RequestUpdateContents(); }
+    }
+}
diff --git a/src/ClassicUO.Client/Game/UI/Gumps/PotionBeltGump.cs b/src/ClassicUO.Client/Game/UI/Gumps/PotionBeltGump.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/UI/Gumps/PotionBeltGump.cs
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using System;
+using System.Linq;
+using ClassicUO.Configuration;
+using ClassicUO.Game.UI.Controls;
+using ClassicUO.Input;
+using Sanctuary;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal sealed class PotionBeltGump : Gump
+{
+    private const int Size = 36, PanelWidth = 164;
+    public PotionBeltGump(World world) : base(world, 0, 0)
+    {
+        CanMove = CanCloseWithRightClick = false;
+        RequestUpdateContents();
+    }
+    public override void Update()
+    {
+        IsVisible = World.InGame && ClassCombatClient.Enabled && ClassBeltClient.Ready;
+        var profile = ProfileManager.CurrentProfile;
+        X = Math.Max(0, profile.GameWindowPosition.X + profile.GameWindowSize.X - PanelWidth - 12);
+        Y = Math.Max(0, profile.GameWindowPosition.Y + profile.GameWindowSize.Y - Height - 14);
+        base.Update();
+    }
+    protected override void UpdateContents()
+    {
+        foreach (var child in Children.ToArray()) { child.Dispose(); }
+        int rows = ClassBeltClient.Overflow ? 4 : ClassBeltClient.Expanded ? ClassBeltClient.Rows : 1;
+        int height = 26 + rows * Size + 17;
+        Add(new AlphaBlendControl(0.9f) { Width = PanelWidth, Height = height, AcceptMouseInput = false });
+        Add(new Label($"Potions  {ClassBeltClient.Rows} row{(ClassBeltClient.Rows == 1 ? "" : "s")}", true, 0x35)
+        { X = 8, Y = 3, AcceptMouseInput = false });
+        Add(new ActionControl(114, 2, 20, 21, ClassBeltClient.Expanded ? "v" : "^", "Show/hide belt rows", _ => ClassBeltClient.Toggle()));
+        Add(new ActionControl(136, 2, 24, 21, "+", "Fill from backpack: healing left, mana right", _ => ClassBeltClient.Send(BeltRequest.Fill)));
+        for (int row = 0; row < rows; row++)
+        {
+            for (int column = 0; column < 4; column++)
+            {
+                int cell = row * 4 + column;
+                var potion = ClassBeltClient.Get(cell);
+                bool locked = row >= ClassBeltClient.Rows;
+                var control = new ActionControl(8 + column * Size, 25 + (rows - 1 - row) * Size, Size - 2, Size - 2,
+                    potion.Serial == 0 ? "+" : "", locked ? "Inactive overflow: right-click to return to backpack" :
+                    potion.Serial == 0 ? "Click to load a healing or mana potion from your backpack" :
+                    $"{PotionName(potion)}: click to drink; right-click to return to backpack",
+                    button =>
+                    {
+                        if (button == MouseButtonType.Right) { ClassBeltClient.Send(BeltRequest.Remove, cell); }
+                        else if (!locked && ClassBeltClient.Alive)
+                        {
+                            ClassBeltClient.Send(potion.Serial == 0 ? BeltRequest.Load : BeltRequest.Use, cell);
+                        }
+                    }, locked ? 0xFF333333u : 0xFF504638u);
+                Add(control);
+                if (potion.Serial != 0)
+                {
+                    var art = new StaticPic(potion.Graphic, potion.Hue) { AcceptMouseInput = false };
+                    art.X = (Size - 2 - art.Width) / 2;
+                    art.Y = (Size - 2 - art.Height) / 2;
+                    control.Add(art);
+                    if (locked) { control.Add(new Label("!", true, 0x21) { X = 2, Y = 2, AcceptMouseInput = false }); }
+                }
+            }
+        }
+        for (int column = 0; column < 4; column++)
+        {
+            Add(new Label((column + 1).ToString(), true, 0x35) { X = 21 + column * Size, Y = 25 + rows * Size, AcceptMouseInput = false });
+        }
+        Width = PanelWidth;
+        Height = height;
+    }
+    private static string PotionName(ClassBeltClient.Cell potion)
+    {
+        string strength = potion.Tier switch { 1 => "Minor ", 2 => "Light ", 4 => "Greater ", 5 => "Super ", _ => "" };
+        return $"{strength}{potion.Kind} potion";
+    }
+    private sealed class ActionControl : Control
+    {
+        private readonly Action<MouseButtonType> _action;
+        public ActionControl(int x, int y, int width, int height, string text, string tooltip,
+            Action<MouseButtonType> action, uint color = 0xFF504638)
+        {
+            X = x; Y = y; Width = width; Height = height;
+            WantUpdateSize = false;
+            AcceptMouseInput = true;
+            _action = action;
+            Add(new Line(0, 0, width, height, color) { AcceptMouseInput = false });
+            Add(new Label(text, true, 0x35) { X = 6, Y = 4, AcceptMouseInput = false });
+            SetTooltip(tooltip);
+        }
+        protected override void OnMouseUp(int x, int y, MouseButtonType button)
+        {
+            if (MouseIsOver && button is MouseButtonType.Left or MouseButtonType.Right)
+            {
+                _action(button);
+                Mouse.CancelDoubleClick = true;
+            }
+            base.OnMouseUp(x, y, button);
+        }
+    }
+}
