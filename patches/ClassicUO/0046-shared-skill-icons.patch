 using Sanctuary;
 
 namespace ClassicUO.Game.UI.Gumps;
+
+internal static class ClassSkillIcon
+{
+    internal static GumpPic Create(CombatAbility ability, int x, int y, int size, bool available = true)
+    {
+        ushort graphic = ClassSkillIcons.For(ability);
+        if (graphic == 0)
+        {
+            return null;
+        }
+        var icon = new GumpPic(x, y, graphic, 0)
+        {
+            Width = size,
+            Height = size,
+            Alpha = available ? 1f : 0.5f,
+            AcceptMouseInput = false,
+            IsFromServer = false
+        };
+        return icon.IsDisposed ? null : icon;
+    }
+}
 
