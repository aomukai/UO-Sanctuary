new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/CharacterTitlesClient.cs
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using System.Collections.Generic;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.Gumps;
+using ClassicUO.IO;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class CharacterTitlesClient
+{
+    private static readonly Dictionary<uint, string> _titles = new();
+    public static string Text(uint serial) => _titles.TryGetValue(serial, out string title) ? title : null;
+    public static void Reset() => _titles.Clear();
+    public static void Receive(World world, ref StackDataReader reader)
+    {
+        if (reader.Length - reader.Position < 6 || reader.ReadUInt8() != TitleProtocol.Version) { return; }
+        uint serial = reader.ReadUInt32BE(); int length = (int)(reader.Length - reader.Position);
+        if (length is < 1 or > TitleProtocol.MaxTextBytes || !world.Mobiles.TryGetValue(serial, out var mobile)) { return; }
+        string text = reader.ReadUTF8(length);
+        if (_titles.Count >= 256 && !_titles.ContainsKey(serial)) { _titles.Clear(); }
+        _titles[serial] = text;
+        UIManager.GetGump<PaperDollGump>(serial)?.UpdateTitle(mobile.Title);
+    }
+}
