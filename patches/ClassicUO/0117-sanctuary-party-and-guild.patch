+// SPDX-License-Identifier: BSD-2-Clause
+
+using System;
+using System.Linq;
+using ClassicUO.Game.UI.Controls;
+using ClassicUO.Input;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+/// <summary>Repaints the stock ModernUO guild layouts after their controls have been decoded.</summary>
+internal static class SanctuaryGuildTheme
+{
+    // ModernUO hashes the full names of its Server.Guilds gump types.
+    private const uint CreateGuild = 0x447F5C9A;
+    private const uint GuildInfo = 0x9855D96A;
+    private const uint GuildRoster = 0xDBF0A77B;
+    private const uint Diplomacy = 0x0491B8AE;
+    private const uint AdvancedSearch = 0x0D8C0E3D;
+    private const uint Invitation = 0xCE5CDF24;
+    private const uint MemberInfo = 0x67AC51D0;
+    private const uint OtherGuildInfo = 0x5E7F31DB;
+    private const uint WarDeclaration = 0x867B075D;
+    private const uint AllianceRoster = 0x5E88D0A6;
+
+    private const uint BronzeBorder = 0xFF567B98;
+    private const uint ButtonFill = 0xFF292D42;
+    private const uint SelectedFill = 0xFF335C77;
+    private const uint InputFill = 0xFF211A20;
+    // The HTML glyph path stores the red and blue channels in reverse order.
+    private const uint Text = 0xD9F0FFFF;
+    private const uint Gold = 0x8AD8FFFF;
+
+    internal static void Apply(Gump gump)
+    {
+        if (!ClassCombatClient.Enabled || gump.ServerSerial is not (
+            CreateGuild or GuildInfo or GuildRoster or Diplomacy or AdvancedSearch or Invitation
+            or MemberInfo or OtherGuildInfo or WarDeclaration or AllianceRoster))
+            return;
+
+        var children = gump.Children.ToArray();
+        var outer = children.OfType<ResizePic>().FirstOrDefault(pic => pic.X == 0 && pic.Y == 0
+            && pic.Graphic is 0x2422 or 0x242C or 0x24AE);
+        if (outer == null)
+            return;
+
+        int width = outer.Width, height = outer.Height;
+        Replace(gump, outer, new SanctuaryBackdrop("character-frame", width, height) { CanCloseWithRightClick = true });
+        gump.X = Math.Clamp(gump.X, 0, Math.Max(0, Client.Game.ClientBounds.Width - width));
+        int maxY = Math.Max(0, Client.Game.ClientBounds.Height - height);
+        gump.Y = Math.Clamp(gump.Y, Math.Min(27, maxY), maxY);
+
+        int selectedTab = gump.ServerSerial switch
+        {
+            GuildInfo => 66,
+            GuildRoster => 236,
+            Diplomacy or AdvancedSearch or AllianceRoster => 401,
+            _ => -1
+        };
+
+        foreach (var control in children)
+        {
+            switch (control)
+            {
+                case ResizePic { Graphic: 0x2486 or 0x0BB8 } panel:
+                    StylePanel(gump, panel, children, panel.Y == 40 && panel.X == selectedTab);
+                    break;
+
+                case GumpPicTiled tile when tile.Graphic is 0x0A40 or 0x0BBC or 0x238D or 0x2711:
+                    uint color = tile.Graphic switch
+                    {
+                        0x0A40 => 0xFF3A4E65,
+                        0x0BBC => 0xFF242F3E,
+                        _ => 0xFF345681
+                    };
+                    Replace(gump, tile, new Line(tile.X, tile.Y, tile.Width, tile.Height, color) { AcceptMouseInput = false });
+                    break;
+
+                case HtmlControl html:
+                    if (gump.ServerSerial == CreateGuild && html.X == 25 && html.Y == 20)
+                    {
+                        html.IsVisible = false;
+                        break;
+                    }
+                    bool selected = selectedTab >= 0 && html.Y == 43 && html.X == selectedTab + 30;
+                    html.ApplyGuildColors(selected ? Gold : Text);
+                    break;
+
+                case Button { ButtonGraphicNormal: 0xF7 or 0xF2 } button:
+                    string caption = button.ButtonID == 0 ? "Cancel" : gump.ServerSerial == CreateGuild ? "Create Guild" : "Accept";
+                    bool creating = gump.ServerSerial == CreateGuild;
+                    int buttonWidth = creating && button.ButtonID != 0 ? 100 : 66;
+                    int buttonX = creating ? button.ButtonID == 0 ? 298 : 375 : button.X;
+                    Replace(gump, button, new SanctuarySheetButton(buttonX, button.Y, buttonWidth,
+                        caption, () => Activate(gump, button), button.ButtonID != 0));
+                    break;
+            }
+        }
+
+        if (gump.ServerSerial == CreateGuild || selectedTab >= 0)
+            gump.Add(new Label("Guild", true, 0x0481, font: 0) { X = 25, Y = 8 });
+        if (selectedTab >= 0)
+            gump.Add(new SanctuarySheetButton(width - 78, 8, 53, "Close", () => gump.OnButtonClick(0)));
+    }
+
+    private static void StylePanel(Gump gump, ResizePic panel, Control[] children, bool selected)
+    {
+        var frame = new Line(panel.X, panel.Y, panel.Width, panel.Height, BronzeBorder) { AcceptMouseInput = false };
+        Replace(gump, panel, frame);
+        int index = gump.Children.IndexOf(frame);
+        var fill = new Line(panel.X + 1, panel.Y + 1, panel.Width - 2, panel.Height - 2,
+            panel.Graphic == 0x0BB8 ? InputFill : selected ? SelectedFill : ButtonFill) { AcceptMouseInput = false };
+        gump.Insert(index + 1, fill);
+        fill.Page = frame.Page;
+
+        var button = children.OfType<Button>().FirstOrDefault(candidate =>
+            candidate.ButtonGraphicNormal == 0x845 && candidate.Page == frame.Page
+            && candidate.X == panel.X + 5 && candidate.Y == panel.Y + 5);
+        if (button == null)
+            return;
+
+        button.IsVisible = false;
+        var target = gump.Add(new HitBox(panel.X, panel.Y, panel.Width, panel.Height, alpha: 0.07f), frame.Page);
+        target.MouseUp += (_, args) =>
+        {
+            if (args.Button == MouseButtonType.Left && target.MouseIsOver)
+                Activate(gump, button);
+        };
+    }
+
+    private static void Activate(Gump gump, Button button)
+    {
+        if (button.ButtonAction == ButtonAction.SwitchPage)
+            gump.ChangePage(button.ToPage);
+        else
+            gump.OnButtonClick(button.ButtonID);
+        Mouse.CancelDoubleClick = true;
+    }
+
+    private static void Replace(Gump gump, Control original, Control replacement)
+    {
+        int index = gump.Children.IndexOf(original);
+        gump.Insert(index, replacement);
+        replacement.Page = original.Page;
+        original.Dispose();
+    }
+}
