+
+internal sealed class SanctuaryAvatarHealthGump : BaseHealthBarGump
+{
+    internal const int FrameWidth = 226;
+    internal const int FrameHeight = 101;
+    private Label _title;
+    private ResourceBar _life, _mana, _stamina;
+
+    public SanctuaryAvatarHealthGump(World world) : base(world, 0, 0) { }
+
+    public SanctuaryAvatarHealthGump(World world, PlayerMobile player) : base(world, player) { }
+
+    protected override void BuildGump()
+    {
+        Width = FrameWidth;
+        Height = FrameHeight;
+        WantUpdateSize = false;
+        CanMove = CanCloseWithRightClick = true;
+        Add(new SanctuaryBackdrop("character-frame", Width, Height));
+        Add(new Line(9, 26, 58, 66, 0xFF547896) { AcceptMouseInput = false });
+        Add(new Line(10, 27, 56, 64, 0xFF2E333F) { AcceptMouseInput = false });
+        Add(new SanctuaryPortrait(World.Player, 11, 28, 54, 62));
+        _title = Add(new Label(World.Player.Name ?? "", true, 0x0481, maxwidth: 200, font: 1) { X = 10, Y = 4 });
+        _life = Add(new ResourceBar(75, 28, "Life", 0xFF3D49BD));
+        _mana = Add(new ResourceBar(75, 50, "Mana", 0xFFA26453));
+        _stamina = Add(new ResourceBar(75, 72, "Stamina", 0xFF57A16D));
+    }
+
+    public override void Update()
+    {
+        base.Update();
+        if (IsDisposed || _title == null || World.Player is not { } player)
+            return;
+
+        _name = player.Name;
+        _isDead = player.IsDead;
+        if (_title.Text != _name)
+            _title.Text = _name ?? "";
+        _life.Set(player.Hits, player.HitsMax);
+        _mana.Set(player.Mana, player.ManaMax);
+        _stamina.Set(player.Stamina, player.StaminaMax);
+    }
+
+    public static SanctuaryAvatarHealthGump At(World world, int x, int y) =>
+        new(world, world.Player) { X = x, Y = y };
+
+    private sealed class ResourceBar : Control
+    {
+        private const int TrackWidth = 141;
+        private readonly Line _fill;
+        private readonly Label _value;
+
+        public ResourceBar(int x, int y, string label, uint color)
+        {
+            X = x;
+            Y = y;
+            Width = TrackWidth;
+            Height = 17;
+            WantUpdateSize = false;
