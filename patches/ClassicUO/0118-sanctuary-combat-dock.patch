diff --git a/src/ClassicUO.Client/Game/UI/Controls/SanctuaryPortrait.cs b/src/ClassicUO.Client/Game/UI/Controls/SanctuaryPortrait.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/UI/Controls/SanctuaryPortrait.cs
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+using System;
+using ClassicUO.Game.Data;
+using ClassicUO.Game.GameObjects;
+using ClassicUO.Game.Scenes;
+using ClassicUO.Renderer;
+using Microsoft.Xna.Framework;
+
+namespace ClassicUO.Game.UI.Controls;
+
+/// <summary>A reusable head-and-shoulders portrait from the native paperdoll layers.</summary>
+internal sealed class SanctuaryPortrait : Control
+{
+    private readonly Mobile _subject;
+    private bool _female;
+    private ushort _body, _hair, _hairHue, _beard, _beardHue;
+    private ushort _hairGump, _beardGump;
+
+    public SanctuaryPortrait(Mobile subject, int x, int y, int width, int height)
+    {
+        _subject = subject;
+        X = x;
+        Y = y;
+        Width = width;
+        Height = height;
+        WantUpdateSize = false;
+        AcceptMouseInput = false;
+    }
+
+    public override bool AddToRenderLists(RenderLists lists, int x, int y, ref float depth)
+    {
+        if (_subject == null || _subject.IsDestroyed)
+            return false;
+
+        var (body, hue) = PaperDollInteractable.GetBodyAppearance(_subject.Graphic, _subject.IsFemale, _subject.Hue);
+        var hair = _subject.FindItemByLayer(Layer.Hair);
+        var beard = _subject.FindItemByLayer(Layer.Beard);
+        ushort hairId = hair?.Graphic ?? 0, beardId = beard?.Graphic ?? 0;
+        if (body != _body || _female != _subject.IsFemale || hairId != _hair || beardId != _beard)
+        {
+            _body = body;
+            _female = _subject.IsFemale;
+            _hair = hairId;
+            _beard = beardId;
+            _hairGump = LayerGraphic(hair);
+            _beardGump = LayerGraphic(beard);
+        }
+        _hairHue = (ushort)((hair?.Hue ?? 0) & 0x3FFF);
+        _beardHue = (ushort)((beard?.Hue ?? 0) & 0x3FFF);
+
+        // The head uses the same coordinate space as hair or horn gumps.
+        var crop = body switch
+        {
+            0x0299 or 0x029A => new Rectangle(67, 41, 48, 54),
+            0x000D or 0x000F => new Rectangle(70, 46, 42, 50),
+            _ => new Rectangle(70, 42, 42, 50)
+        };
+        var target = new Rectangle(x, y, Width, Height);
+        Paint(lists, body, hue, true, crop, target, depth);
+        Paint(lists, _beardGump, _beardHue, beard?.ItemData.IsPartialHue == true, crop, target, depth + 0.001f);
+        Paint(lists, _hairGump, _hairHue, hair?.ItemData.IsPartialHue == true, crop, target, depth + 0.002f);
+        return true;
+    }
+
+    private ushort LayerGraphic(Item item) => item == null || item.ItemData.AnimID == 0 ? (ushort)0
+        : PaperDollInteractable.GetAnimID(_subject.Graphic, item.Graphic, item.ItemData.AnimID, _subject.IsFemale);
+
+    private static void Paint(RenderLists lists, ushort graphic, ushort hue, bool partial,
+        Rectangle crop, Rectangle target, float depth)
+    {
+        if (graphic == 0)
+            return;
+        ref readonly var art = ref Client.Game.UO.Gumps.GetGump(graphic);
+        if (art.Texture == null)
+            return;
+        var visible = Rectangle.Intersect(crop, new Rectangle(0, 0, art.UV.Width, art.UV.Height));
+        if (visible.Width == 0 || visible.Height == 0)
+            return;
+        var source = new Rectangle(art.UV.X + visible.X, art.UV.Y + visible.Y, visible.Width, visible.Height);
+        var destination = new Rectangle(
+            target.X + (visible.X - crop.X) * target.Width / crop.Width,
+            target.Y + (visible.Y - crop.Y) * target.Height / crop.Height,
+            Math.Max(1, visible.Width * target.Width / crop.Width),
+            Math.Max(1, visible.Height * target.Height / crop.Height));
+        var texture = art.Texture;
+        var color = ShaderHueTranslator.GetHueVector(hue, partial, 1f, true);
+        lists.AddGumpWithAtlas(batcher =>
+        {
+            batcher.Draw(texture, destination, source, color, depth);
+            return true;
+        });
+    }
+}
