+            row += look.Female ? 1 : 0;
+            var swatch = new Color { PackedValue = Client.Game.UO.FileManager.Hues.GetPolygoneColor(22, look.Skin) };
+            bool tint = look.Skin != 0;
+            float strength = look.Race == RaceType.GARGOYLE ? 0.78f : look.Race == RaceType.ELF ? 0.64f : 0.49f;
