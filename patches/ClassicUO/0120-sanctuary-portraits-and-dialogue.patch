+        internal static NativeLayer Load(ushort graphic)
+        {
+            var layer = Client.Game.UO.FileManager.Gumps.GetGump(graphic);
+            if (layer.Pixels.IsEmpty)
+                return null;
+
+            int left = layer.Width, top = layer.Height, right = -1, bottom = -1;
+            for (int y = 0; y < layer.Height; y++)
+            for (int x = 0; x < layer.Width; x++)
+            {
+                if (layer.Pixels[y * layer.Width + x] == 0) continue;
+                left = Math.Min(left, x);
+                right = Math.Max(right, x);
+                top = Math.Min(top, y);
+                bottom = Math.Max(bottom, y);
