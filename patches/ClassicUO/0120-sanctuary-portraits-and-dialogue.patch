@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+using System;
+using ClassicUO.Game.UI.Controls;
+using Sanctuary;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal sealed class SanctuaryDialogueGump : Gump
+{
+    private const int PanelWidth = 568, PanelHeight = 310;
+    private bool _waiting, _closedByServer;
+
+    public uint Token { get; private set; }
+
+    public SanctuaryDialogueGump(World world) : base(world, 0, 0)
+    {
+        Width = PanelWidth;
+        Height = PanelHeight;
+        X = Math.Max(0, (Client.Game.ClientBounds.Width - Width) / 2);
+        Y = Math.Max(0, (Client.Game.ClientBounds.Height - Height) / 2);
+        CanMove = CanCloseWithRightClick = true;
+        LayerOrder = UILayer.Over;
+        WantUpdateSize = false;
+    }
+
+    public void Show(uint token, byte portrait, string name, string line, string[] replies)
+    {
+        Token = token;
+        _waiting = false;
+        Clear();
+        Add(new SanctuaryBackdrop("character-frame", Width, Height) { CanCloseWithRightClick = true });
+        Add(new Line(22, 47, 524, 1, 0xFF486581) { AcceptMouseInput = false });
+        Add(new Line(22, 58, 144, 144, 0xFF567B98) { AcceptMouseInput = false });
+        Add(new SanctuaryPortrait(portrait, 24, 60, 140, 140));
+        Add(new Label(name, true, 0x0481, maxwidth: 490, font: 0) { X = 24, Y = 15 });
+        Add(new Label(line, true, 0x0481, maxwidth: 348, font: 1) { X = 190, Y = 63 });
+        for (int i = 0; i < replies.Length; i++)
+        {
+            byte choice = (byte)i;
+            Add(new SanctuarySheetButton(187, 150 + i * 29, 355, replies[i], () => Choose(choice)));
+        }
+        Add(new SanctuarySheetButton(22, 266, 144, "Farewell", Dispose));
+    }
+
+    private void Choose(byte choice)
+    {
+        if (_waiting)
+            return;
+        _waiting = true;
+        AvatarDialogueClient.Reply(Token, choice);
+    }
+
+    public void CloseFromServer()
+    {
+        _closedByServer = true;
+        Dispose();
+    }
+
+    public override void Dispose()
+    {
+        if (!IsDisposed && !_closedByServer && World.InGame && Token != 0)
+            AvatarDialogueClient.Reply(Token, PortraitProtocol.Leave);
+        base.Dispose();
+    }
+}
diff --git a/src/ClassicUO.Client/Game/AvatarDialogueClient.cs b/src/ClassicUO.Client/Game/AvatarDialogueClient.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/AvatarDialogueClient.cs
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.Gumps;
+using ClassicUO.IO;
+using ClassicUO.Network;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class AvatarDialogueClient
+{
+    internal static void Receive(World world, ref StackDataReader reader)
+    {
+        if (!world.InGame || world.Player == null || reader.Remaining < 2
+            || reader.ReadUInt8() != PortraitProtocol.Version)
+            return;
+
+        byte kind = reader.ReadUInt8();
+        if (kind == PortraitProtocol.AvatarFace && reader.Remaining == 1)
+        {
+            byte face = reader.ReadUInt8();
+            if (face < PortraitProtocol.FaceCount)
+                world.Player.SanctuaryFace = face;
+            return;
+        }
+
+        if (reader.Remaining < 4)
+            return;
+        uint token = reader.ReadUInt32BE();
+        var dialogue = UIManager.GetGump<SanctuaryDialogueGump>();
+        if (kind == PortraitProtocol.Closed && reader.Remaining == 0)
+        {
+            if (dialogue?.Token == token)
+                dialogue.CloseFromServer();
+            return;
+        }
+        if (kind != PortraitProtocol.Conversation || reader.Remaining < 2)
+            return;
+        byte portrait = reader.ReadUInt8();
+        int count = reader.ReadUInt8();
+        if (portrait >= PortraitProtocol.NpcPortraitCount || count > PortraitProtocol.MaxReplies
+            || !ReadText(ref reader, out string name) || !ReadText(ref reader, out string line))
+            return;
+        var replies = new string[count];
+        for (int i = 0; i < count; i++)
+            if (!ReadText(ref reader, out replies[i]))
+                return;
+        if (reader.Remaining != 0)
+            return;
+
+        if (dialogue == null)
+            UIManager.Add(dialogue = new SanctuaryDialogueGump(world));
+        dialogue.Show(token, portrait, name, line, replies);
+        dialogue.BringOnTop();
+    }
+
+    private static bool ReadText(ref StackDataReader reader, out string text)
+    {
+        text = null;
+        if (reader.Remaining < 2)
+            return false;
+        int length = reader.ReadUInt16BE();
+        if (length is < 1 or > PortraitProtocol.MaxTextBytes || reader.Remaining < length)
+            return false;
+        text = reader.ReadUTF8(length);
+        return true;
+    }
+
+    internal static void Reply(uint token, byte choice)
+    {
+        var writer = new StackDataWriter(PortraitProtocol.ReplyPacketLength);
+        writer.WriteUInt8(0xBF);
+        writer.WriteUInt16BE(PortraitProtocol.ReplyPacketLength);
+        writer.WriteUInt16BE(PortraitProtocol.SubCommand);
+        writer.WriteUInt8(PortraitProtocol.Version);
+        writer.WriteUInt32BE(token);
+        writer.WriteUInt8(choice);
+        NetClient.Socket.Send(writer.BufferWritten);
+        writer.Dispose();
+    }
+}
