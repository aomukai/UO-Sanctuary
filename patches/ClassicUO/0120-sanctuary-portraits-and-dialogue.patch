+                uint north = y > 0 ? pixels[x + (y - 1) * width] : 0;
+                uint west = x > 0 ? pixels[x - 1 + y * width] : 0;
+                uint east = x + 1 < width ? pixels[x + 1 + y * width] : 0;
+                uint south = y + 1 < height ? pixels[x + (y + 1) * width] : 0;
+                int index = 2 * x + 4 * width * y;
+                bool edge = north != south && west != east;
+                scaled[index] = edge && west == north ? west : center;
+                scaled[index + 1] = edge && north == east ? east : center;
+                scaled[index + 2 * width] = edge && west == south ? west : center;
+                scaled[index + 2 * width + 1] = edge && south == east ? east : center;
+            }
