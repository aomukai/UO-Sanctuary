+        private bool TryLootChest(Item chest, Item item)
+        {
+            Point offset = Mouse.LDragOffset;
+            if (Keyboard.Ctrl || item.IsDestroyed || item.Container != chest.Serial
+                || UIManager.MouseOverControl is not ItemGump control || control.LocalSerial != item.Serial
+                || UIManager.LastControlMouseDown(MouseButtonType.Left) != control
+                || Math.Abs(offset.X) >= Constants.MIN_PICKUP_DRAG_DISTANCE_PIXELS
+                || Math.Abs(offset.Y) >= Constants.MIN_PICKUP_DRAG_DISTANCE_PIXELS)
+            {
+                return false;
+            }
+
+            if (ClassLootClient.TryTakeChestGold(World, chest.Serial, item.Serial))
+            {
+                return true;
+            }
+
+            // The rarewood chest uses the default container gump, so identify it by its item art.
+            bool isChest = Graphic is 0x0042 or 0x0049 or 0x004A or >= 0x0109 and <= 0x010D
+                || chest.Graphic is 0x2DF1 or 0x2DF2;
+            if (!isChest || chest.Layer == Layer.Bank || World.Player.FindItemByLayer(Layer.Backpack) is not Item backpack)
+            {
+                return false;
+            }
+
+            GameActions.GrabItem(World, item.Serial, item.Amount, backpack.Serial);
+            return true;
