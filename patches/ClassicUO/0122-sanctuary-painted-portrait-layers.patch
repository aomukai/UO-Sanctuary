+
+    private static readonly Dictionary<Sheet, (Color[] Pixels, int Width, int Height)> _sheets = new();
+    private static readonly Dictionary<(Sheet, int), Cutout> _cutouts = new();
+    private static readonly float[] _humanMouth = [.726f, .692f, .671f, .702f, .735f, .751f, .754f, .755f];
+
+    internal static void Paint(Color[] face, int width, int height, PortraitLook look, float crown, float forehead)
+    {
+        float mouth = look.Race == RaceType.GARGOYLE ? .76f : _humanMouth[look.Face];
+        Paint(face, width, height, look.Beard, look.BeardHue, crown, mouth, forehead);
+        Paint(face, width, height, look.Hair, look.HairHue, crown, mouth, forehead);
+    }
+
+    private static void Paint(Color[] face, int width, int height, ushort item, ushort hue, float crown, float mouth, float forehead)
+    {
+        if (!_styles.TryGetValue(item, out var style))
+            return;
+
+        var cutout = GetCutout(style.Sheet, style.Tile);
+        var source = cutout.Source;
+        bool wig = style.Sheet is Sheet.Human or Sheet.Elf;
+        float fit = wig ? Math.Clamp(forehead / .47f, .94f, 1.10f) : 1f;
+        int w = (int)MathF.Round(style.Width * fit * width), h = (int)MathF.Round(style.Height * height);
+        float top = style.Sheet switch
+        {
+            Sheet.Horn => crown + style.Offset - style.Height,
+            Sheet.Beard or Sheet.Jaw => mouth + style.Offset,
+            _ => crown + style.Offset
+        };
+        int startY = (int)MathF.Round(Math.Max(.01f, top) * height);
+        Span<Color> dye = stackalloc Color[32];
+        for (ushort i = 0; i < dye.Length; i++)
+        {
+            dye[i] = hue == 0
+                ? new Color(4 + i * 7, 3 + i * 6, 3 + i * 5)
+                : new Color { PackedValue = Client.Game.UO.FileManager.Hues.GetPolygoneColor(i, hue) | 0xFF000000 };
+        }
+
+        for (int y = startY; y < Math.Min(height, startY + h); y++)
+        {
+            // Give the longer elven styles room around the eyes and cheekbones.
+            float spread = style.Sheet == Sheet.Elf
+                ? .22f * Math.Clamp((y / (float)height - .30f) / .20f, 0f, 1f) : 0f;
+            int rowWidth = (int)MathF.Round(w * (1f + spread));
+            int left = (int)MathF.Round(style.Center * width - rowWidth / 2f);
+            int sampleY = source.Y + (y - startY) * source.Height / h;
+            for (int x = Math.Max(0, left); x < Math.Min(width, left + rowWidth); x++)
+            {
+                int dx = (x - left) * source.Width / rowWidth;
+                int sampleX = source.X + (style.Mirror ? source.Width - 1 - dx : dx);
+                Color material = cutout.Pixels[sampleY * cutout.Stride + sampleX];
+                int shade = (material.R + material.G + material.B) / 3;
+                if (material.A < 24 || shade > 248)
+                    continue;
+
+                float alpha = material.A / 255f;
+                if (style.Sheet == Sheet.Beard)
+                {
+                    float lipX = (x / (float)width - .5f) / .113f;
+                    float lipY = (y / (float)height - mouth) / .024f;
+                    alpha *= Math.Clamp((lipX * lipX + lipY * lipY - .61f) * 2f, 0, 1);
+                }
+                int dyeIndex = Math.Clamp((shade - 38) * 31 / 205, 0, 31);
+                Color color = IsAccessory(style, sampleX, sampleY)
+                    ? new Color(shade, (int)(shade * .96f), (int)(shade * .81f)) : dye[dyeIndex];
+                int index = y * width + x;
+                face[index] = Color.Lerp(face[index], color, alpha);
+            }
+        }
+    }
+
+    private static bool IsAccessory(Style style, int x, int y)
+    {
+        if (style.Sheet != Sheet.Elf)
+            return false;
+        // These two decorations keep their pale colors when the hair is dyed.
+        if (style.Tile == 1)
+            return y < 164 && x > 644 - y * .23f;
+        if (style.Tile == 4)
+        {
+            float dx = (x - 110f) / 33f, dy = (y - 479f) / 35f;
+            return dx * dx + dy * dy < 1f;
+        }
+        return false;
+    }
+
+    private static Cutout GetCutout(Sheet sheet, int tile)
+    {
+        if (_cutouts.TryGetValue((sheet, tile), out var cached))
+            return cached;
+        if (!_sheets.TryGetValue(sheet, out var atlas))
+        {
+            string resource = sheet switch
+            {
+                Sheet.Human => "portrait-hair-human",
+                Sheet.Elf => "portrait-hair-elf",
+                Sheet.Beard => "portrait-beards",
+                Sheet.Horn => "portrait-horns",
+                _ => "portrait-jaw-horns"
+            };
+            using var texture = SanctuaryPortrait.Load(resource);
+            var pixels = new Color[texture.Width * texture.Height];
+            texture.GetData(pixels);
+            _sheets[sheet] = atlas = (pixels, texture.Width, texture.Height);
+        }
+
+        var cell = Cell(sheet, tile, atlas.Width, atlas.Height);
+        int left = cell.Right, top = cell.Bottom, right = cell.Left - 1, bottom = cell.Top - 1;
+        for (int row = cell.Top; row < cell.Bottom; row++)
+        for (int col = cell.Left; col < cell.Right; col++)
+        {
+            Color ink = atlas.Pixels[row * atlas.Width + col];
+            if (ink.A < 182 || (ink.R + ink.G + ink.B) / 3 > 240)
+                continue;
+            left = Math.Min(left, col);
+            top = Math.Min(top, row);
+            right = Math.Max(right, col);
+            bottom = Math.Max(bottom, row);
+        }
+        var bounds = right < left ? cell : new Rectangle(left, top, right - left + 1, bottom - top + 1);
+        return _cutouts[(sheet, tile)] = new Cutout(atlas.Pixels, atlas.Width, bounds);
+    }
+
+    private static Rectangle Cell(Sheet sheet, int tile, int width, int height)
+    {
+        // The large cutouts are centered on an even grid. Their transparent
+        // borders are hand checked where ponytails or tall crests cross a grid line.
+        int columns = sheet == Sheet.Jaw ? 2 : 4;
+        int rows = sheet == Sheet.Jaw ? 2 : sheet == Sheet.Horn ? 4 : 3;
+        int row = tile / columns, col = tile % columns;
+        int left = col * width / columns, right = (col + 1) * width / columns;
+        int top = row * height / rows, bottom = (row + 1) * height / rows;
+        switch (sheet)
+        {
+            case Sheet.Human:
+                if (tile == 2) bottom = 388;
+                if (tile == 6) top = 393;
+                if (tile == 9) left += 5;
+                break;
+            case Sheet.Elf:
+                top = row == 0 ? 0 : row == 1 ? 378 : col == 0 ? 733 : 748;
+                bottom = row == 0 ? 378 : row == 1 ? col == 0 ? 733 : 748 : height;
+                break;
+            case Sheet.Beard:
+                top = row == 0 ? 0 : 399;
+                bottom = row == 0 ? 397 : 719;
+                break;
+        }
+        return new Rectangle(left, top, right - left, bottom - top);
+    }
+}
