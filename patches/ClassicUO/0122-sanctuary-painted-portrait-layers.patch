+
+namespace ClassicUO.Game.UI.Controls;
+
+internal static class PaintedPortraitLayers
+{
+    private enum Sheet { Human, Elf, Beard, Horn, Jaw }
+    private readonly record struct Style(Sheet Sheet, int Tile, float Width, float Height, float Offset,
+        float Center = 0.5f, bool Mirror = false);
+    private readonly record struct Cutout(Color[] Pixels, int Stride, Rectangle Source);
+
+    private static readonly Dictionary<ushort, Style> _styles = new()
+    {
+        // Native item IDs still select the corresponding world appearance.
+        [0x203B] = new(Sheet.Human, 0, .66f, .40f, -.035f),  // Short
+        [0x203C] = new(Sheet.Human, 1, .89f, .87f, -.045f),  // Long
+        [0x203D] = new(Sheet.Human, 2, .72f, .77f, -.045f, .385f, true), // Ponytail
+        [0x2044] = new(Sheet.Human, 3, .62f, .39f, -.15f),   // Mohawk
+        [0x2045] = new(Sheet.Human, 4, .76f, .57f, -.045f),  // Pageboy
+        [0x204A] = new(Sheet.Human, 5, .65f, .54f, -.18f),   // Topknot
+        [0x2047] = new(Sheet.Human, 6, .76f, .45f, -.075f),  // Afro
+        [0x2048] = new(Sheet.Human, 7, .65f, .39f, .035f),   // Receding
+        [0x2049] = new(Sheet.Human, 8, .92f, .66f, -.025f),  // Pigtails
+        [0x2046] = new(Sheet.Human, 9, .70f, .49f, -.13f),   // Bun
+
+        [0x2FBF] = new(Sheet.Elf, 0, .75f, .60f, -.045f), // Mid-long
+        [0x2FC0] = new(Sheet.Elf, 1, .88f, .91f, -.16f, .49f), // Long Feather
+        [0x2FC1] = new(Sheet.Elf, 2, .70f, .38f, -.045f), // Short
+        [0x2FC2] = new(Sheet.Elf, 3, .73f, .65f, -.065f), // Mullet
+        [0x2FCC] = new(Sheet.Elf, 4, .90f, .83f, -.055f), // Flower
+        [0x2FCD] = new(Sheet.Elf, 5, .85f, .85f, -.05f), // Long
+        [0x2FCE] = new(Sheet.Elf, 6, .73f, .51f, -.095f), // Knob
+        [0x2FCF] = new(Sheet.Elf, 7, .77f, .77f, -.055f), // Braided
+        [0x2FD0] = new(Sheet.Elf, 8, .74f, .58f, -.14f), // Bun
+        [0x2FD1] = new(Sheet.Elf, 9, .80f, .51f, -.105f), // Spiked
+
+        [0x2040] = new(Sheet.Beard, 0, .20f, .16f, .026f), // Goatee
+        [0x203E] = new(Sheet.Beard, 1, .57f, .38f, -.078f), // Long beard
+        [0x203F] = new(Sheet.Beard, 2, .54f, .25f, -.125f), // Short beard
+        [0x2041] = new(Sheet.Beard, 3, .36f, .079f, -.092f), // Moustache
+        [0x204B] = new(Sheet.Beard, 4, .56f, .29f, -.133f), // Medium short
+        [0x204C] = new(Sheet.Beard, 5, .56f, .34f, -.126f), // Medium long
