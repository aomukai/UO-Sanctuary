+        [0x425E] = new(Sheet.Horn, 6, .51f, .21f, .16f),
+        [0x425F] = new(Sheet.Horn, 7, .70f, .19f, .17f),
+        [0x4261] = new(Sheet.Horn, 8, .58f, .10f, .15f),
+        [0x4262] = new(Sheet.Horn, 9, .81f, .32f, .25f),
+        [0x4273] = new(Sheet.Horn, 10, .36f, .18f, .14f),
+        [0x4274] = new(Sheet.Horn, 11, .43f, .26f, .14f),
+        [0x4275] = new(Sheet.Horn, 12, .33f, .21f, .14f),
+        [0x42AA] = new(Sheet.Horn, 13, .35f, .31f, .15f),
+        [0x42AB] = new(Sheet.Horn, 14, .59f, .28f, .18f),
