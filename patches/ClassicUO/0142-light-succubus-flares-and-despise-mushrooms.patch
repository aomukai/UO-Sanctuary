+
+        private Texture2D GetSoftLightTexture(ushort hue)
+        {
+            if (_softLightTextures.TryGetValue(hue, out var cached))
+                return cached;
+
+            const int size = 64;
+            const float center = (size - 1) * 0.5f;
+            Color tint = hue == 0 ? Color.White : new Color
+            {
+                PackedValue = Client.Game.UO.FileManager.Hues.GetColor(0x7FFF, hue) | 0xFF000000
+            };
+            var pixels = new Color[size * size];
+            for (int y = 0; y < size; y++)
+            for (int x = 0; x < size; x++)
+            {
+                float dx = (x - center) / center, dy = (y - center) / center;
+                float falloff = Math.Max(0f, 1f - dx * dx - dy * dy);
+                falloff *= falloff;
+                pixels[y * size + x] = new Color((int)(tint.R * falloff), (int)(tint.G * falloff), (int)(tint.B * falloff));
+            }
+
+            var texture = new Texture2D(Client.Game.GraphicsDevice, size, size);
+            texture.SetData(pixels);
+            _softLightTextures.Add(hue, texture);
+            return texture;
         }
 
