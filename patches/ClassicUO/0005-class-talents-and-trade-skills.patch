+        // Reuse the installed paperdoll button's blue face and gold rim. Its caption is
+        // baked into the art, so tile a clean column between the unchanged end caps.
+        private sealed class ClassButton : Control
+        {
+            private readonly int _buttonID;
+            private bool _pressed;
+
+            public ClassButton(int x, int y, int buttonID)
+            {
+                _buttonID = buttonID;
+                X = x;
+                Y = y;
+                ref readonly var art = ref Client.Game.UO.Gumps.GetGump(0x07df);
+                Width = art.UV.Width;
+                Height = art.UV.Height;
+                CanMove = false;
+                AcceptMouseInput = true;
+                WantUpdateSize = false;
+                var caption = new Label("CLASS", false, 0x0481, font: 1);
+                caption.X = (Width - caption.Width) / 2;
+                caption.Y = (Height - caption.Height) / 2;
+                Add(caption);
+            }
+
+            protected override void OnMouseDown(int x, int y, MouseButtonType button)
+            {
+                if (button == MouseButtonType.Left)
+                {
+                    _pressed = true;
+                }
+                base.OnMouseDown(x, y, button);
+            }
+
+            protected override void OnMouseUp(int x, int y, MouseButtonType button)
+            {
+                if (button == MouseButtonType.Left)
+                {
+                    _pressed = false;
+                    if (MouseIsOver)
+                    {
+                        OnButtonClick(_buttonID);
+                        Mouse.CancelDoubleClick = true;
+                    }
+                }
+            }
+
+            public override bool AddToRenderLists(RenderLists renderLists, int x, int y, ref float layerDepthRef)
+            {
+                ushort graphic = MouseIsOver ? (_pressed ? (ushort)0x07e0 : (ushort)0x07e1) : (ushort)0x07df;
+                ref readonly var art = ref Client.Game.UO.Gumps.GetGump(graphic);
+                var texture = art.Texture;
+                var source = art.UV;
+                var hue = ShaderHueTranslator.GetHueVector(0, false, Alpha, true);
+                float depth = layerDepthRef;
+                const int cap = 10;
+                if (texture != null)
+                {
+                    renderLists.AddGumpWithAtlas(batcher =>
+                    {
+                        batcher.Draw(texture, new Rectangle(x, y, cap, Height),
+                            new Rectangle(source.X, source.Y, cap, source.Height), hue, depth);
+                        batcher.Draw(texture, new Rectangle(x + cap, y, Width - cap * 2, Height),
+                            new Rectangle(source.Right - cap - 1, source.Y, 1, source.Height), hue, depth);
+                        batcher.Draw(texture, new Rectangle(x + Width - cap, y, cap, Height),
+                            new Rectangle(source.Right - cap, source.Y, cap, source.Height), hue, depth);
+                        return true;
+                    });
+                }
+                return base.AddToRenderLists(renderLists, x, y, ref layerDepthRef);
             }
         }
 
