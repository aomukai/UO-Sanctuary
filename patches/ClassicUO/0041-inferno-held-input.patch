diff --git a/src/ClassicUO.Client/Game/ClassCombatChannelClient.cs b/src/ClassicUO.Client/Game/ClassCombatChannelClient.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/ClassCombatChannelClient.cs
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using ClassicUO.Game.GameObjects;
+using ClassicUO.Game.Managers;
+using ClassicUO.Input;
+using ClassicUO.IO;
+using ClassicUO.Network;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static partial class ClassCombatClient
+{
+    private static int _channelSource=-1;
+    private static uint _nextChannelUpdate;
+    private static bool BeginChannel(World world,int source)
+    {
+        if(!Enabled||world.Player.IsDead||MovementOnly||Recovering||!Client.Game.IsActive
+            ||!UIManager.IsMouseOverWorld||UIManager.IsDragging||world.TargetManager.IsTargeting
+            ||world.CustomHouseManager!=null||Client.Game.UO.GameCursor.ItemHold.Enabled){return false;}
+        Stop(world);_channelSource=source;
+        if(!SendChannelAim(world,CombatRequest.ChannelStart)){EndChannel();return false;}
+        _nextChannelUpdate=Time.Ticks+CombatProtocol.HoldHeartbeatMs;return true;
+    }
+    public static void EndChannel(int source=-1)
+    {
+        if(_channelSource<0||source>=0&&source!=_channelSource){return;}
+        var writer=new StackDataWriter(12);
+        writer.WriteUInt8(0xBF);writer.WriteUInt16BE(12);writer.WriteUInt16BE(CombatProtocol.SubCommand);
+        writer.WriteUInt8(CombatProtocol.Version);writer.WriteUInt8((byte)CombatRequest.ChannelEnd);
+        writer.WriteUInt32BE(++_sequence);writer.WriteUInt8((byte)_channelSource);
+        NetClient.Socket.Send(writer.BufferWritten);writer.Dispose();_channelSource=-1;
+    }
+    private static void UpdateChannel(World world)
+    {
+        if(_channelSource<0){return;}
+        bool bound=(_channelSource==0?Left:_channelSource==1?Right:ClassSkillBindingsClient.Quick(_channelSource-2))==CombatAbility.Inferno;
+        if(!bound||!Client.Game.IsActive||world.Player.IsDead||MovementOnly||!UIManager.IsMouseOverWorld||UIManager.IsDragging
+            ||world.TargetManager.IsTargeting||world.CustomHouseManager!=null||Client.Game.UO.GameCursor.ItemHold.Enabled
+            ||_channelSource==0&&!Mouse.LButtonPressed||_channelSource==1&&!Mouse.RButtonPressed)
+        {EndChannel();return;}
+        StopMovement(world);
+        if(unchecked((int)(Time.Ticks-_nextChannelUpdate))<0){return;}
+        _nextChannelUpdate=Time.Ticks+CombatProtocol.HoldHeartbeatMs;
+        if(!SendChannelAim(world,CombatRequest.ChannelAim)){EndChannel();}
+    }
+    private static bool SendChannelAim(World world,CombatRequest action)
+    {
+        if(!ClassBeltClient.TryAim(world,out var x,out var y,out var z)){return false;}
+        uint target=SelectedObject.Object is Mobile mobile&&Hostile(mobile)?mobile.Serial:0;
+        var writer=new StackDataWriter(22);
+        writer.WriteUInt8(0xBF);writer.WriteUInt16BE(22);writer.WriteUInt16BE(CombatProtocol.SubCommand);
+        writer.WriteUInt8(CombatProtocol.Version);writer.WriteUInt8((byte)action);writer.WriteUInt32BE(++_sequence);
+        writer.WriteUInt8((byte)_channelSource);writer.WriteUInt8((byte)CombatAbility.Inferno);
+        writer.WriteUInt32BE(target);writer.WriteUInt16BE(x);writer.WriteUInt16BE(y);writer.WriteUInt8((byte)z);
+        NetClient.Socket.Send(writer.BufferWritten);writer.Dispose();return true;
+    }
+}
