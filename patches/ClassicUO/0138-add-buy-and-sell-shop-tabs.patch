+    internal static void RequestShopTab(uint serial, VendorShopTabs tab)
+    {
+        using var writer = new StackDataWriter(PortraitProtocol.ShopTabPacketLength);
+        writer.WriteUInt8(0xBF);
+        writer.WriteUInt16BE(PortraitProtocol.ShopTabPacketLength);
+        writer.WriteUInt16BE(PortraitProtocol.SubCommand);
+        writer.WriteUInt8(PortraitProtocol.Version);
+        writer.WriteUInt8(PortraitProtocol.VendorShop);
+        writer.WriteUInt8((byte)tab);
+        writer.WriteUInt32BE(serial);
+        NetClient.Socket.Send(writer.BufferWritten);
+    }
