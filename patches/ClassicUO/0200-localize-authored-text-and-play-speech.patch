+// SPDX-License-Identifier: BSD-2-Clause
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text.Json;
+using ClassicUO.Configuration;
+using ClassicUO.Utility.Logging;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class SanctuaryLocalization
+{
+    private static readonly Dictionary<string, Dictionary<string, string>> _catalogs = new(StringComparer.Ordinal);
+    internal static string Locale => AuthoredTextProtocol.Locale(Settings.GlobalSettings.Language);
+    internal static string DataPath => Path.Combine(CUOEnviroment.ExecutablePath, "Data", "Sanctuary");
+
+    internal static string Text(string key, string fallback)
+    {
+        if (!AuthoredTextProtocol.ValidId(key))
+            return fallback;
+        return Catalog(Locale).GetValueOrDefault(key)
+            ?? (Locale != "en" ? Catalog("en").GetValueOrDefault(key) : null)
+            ?? fallback;
+    }
+
+    internal static string Ui(string english, string german, string japanese) => Locale switch
+    {
+        "de" => german,
+        "ja" => japanese,
+        _ => english
+    };
+
+    private static Dictionary<string, string> Catalog(string locale)
+    {
+        if (_catalogs.TryGetValue(locale, out var cached))
+            return cached;
+
+        var catalog = new Dictionary<string, string>(StringComparer.Ordinal);
+        _catalogs.Add(locale, catalog);
+        var path = Path.Combine(DataPath, "Localization", locale + ".json");
+        if (!File.Exists(path))
+            return catalog;
+        try
+        {
+            using var file = File.OpenRead(path);
+            using var json = JsonDocument.Parse(file);
+            if (json.RootElement.ValueKind != JsonValueKind.Object)
+                return catalog;
+
+            foreach (var entry in json.RootElement.EnumerateObject())
+                if (AuthoredTextProtocol.ValidId(entry.Name) && entry.Value.ValueKind == JsonValueKind.String
+                    && !string.IsNullOrWhiteSpace(entry.Value.GetString()))
+                    catalog[entry.Name] = entry.Value.GetString();
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException)
+        {
+            Log.Warn($"Could not read the Sanctuary {locale} localization catalog: {ex.Message}");
+        }
+
+        return catalog;
+    }
+}
