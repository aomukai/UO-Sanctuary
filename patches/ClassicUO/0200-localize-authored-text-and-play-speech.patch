+// SPDX-License-Identifier: BSD-2-Clause
+
+using System;
+using ClassicUO.Configuration;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.Controls;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal sealed class SanctuaryReadingGump : Gump
+{
+    internal SanctuaryReadingGump(World world, string title, string author, string body, string narrationId) : base(world, 0, 0)
+    {
+        var bounds = Client.Game.ClientBounds;
+        Width = Math.Clamp(bounds.Width - 16, 280, 560);
+        Height = Math.Clamp(bounds.Height - 16, 224, 420);
+        X = Math.Max(0, (bounds.Width - Width) / 2);
+        Y = Math.Max(0, (bounds.Height - Height) / 2);
+        CanMove = CanCloseWithRightClick = true;
+        WantUpdateSize = false;
+
+        const int pad = 24;
+        int textWidth = Width - 2 * pad;
+        int footer = Height - 48;
+        byte font = Settings.GlobalSettings.ResolveDialogueFont(Client.Game.UO.FileManager.Fonts);
+        Add(new SanctuaryBackdrop("character-frame", Width, Height) { CanCloseWithRightClick = true });
+        var headline = Add(new Label(title, true, 0x0481, maxwidth: textWidth, font: font, scale: 1.2f)
+            { X = pad, Y = 16 });
+        int top = headline.Y + headline.Height;
+        if (!string.IsNullOrWhiteSpace(author))
+        {
+            var byline = Add(new Label(author, true, 0x0481, maxwidth: textWidth, font: font) { X = pad, Y = top + 5 });
+            top = byline.Y + byline.Height;
+        }
+
+        top = Math.Min(top + 12, footer - 35);
+        Add(new Line(pad, top - 4, textWidth, 1, 0xFF486581) { AcceptMouseInput = false });
+        var reading = Add(new ScrollArea(pad, top + 8, textWidth, footer - top - 16, true));
+        reading.Add(new Label(body, true, 0x0481, maxwidth: textWidth - 18, font: font));
+        Add(new SanctuarySheetButton(pad, footer, 104, SanctuaryLocalization.Ui("Close", "Schließen", "閉じる"),
+            Dispose, height: 30, font: font));
+
+        if (SanctuarySpeech.HasRecording(narrationId))
+            Add(new SanctuaryNarrationButton(this, narrationId, Width - pad - 114, footer, 114, font));
+    }
+}
+
