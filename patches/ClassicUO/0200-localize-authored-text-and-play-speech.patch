+// SPDX-License-Identifier: BSD-2-Clause
+
+using System;
+using System.IO;
+using ClassicUO.Configuration;
+using ClassicUO.Game.Data;
+using ClassicUO.Game.GameObjects;
+using ClassicUO.Utility.Logging;
+using Microsoft.Xna.Framework.Audio;
+using Sanctuary;
+
+namespace ClassicUO.Game.Managers;
+
+internal sealed class SanctuarySpeech
+{
+    private SoundEffect _clip;
+    private SoundEffectInstance _voice;
+    private object _owner;
+    private TextObject _overhead;
+
+    internal bool Busy => _voice?.State == SoundState.Playing;
+    internal bool Playing(object owner) => _owner == owner && Busy;
+
+    private static float Volume => Math.Clamp(Settings.GlobalSettings.SanctuarySpeechVolume, 0, 100) / 100f;
+    private static bool Enabled => Settings.GlobalSettings.SanctuarySpeechEnabled && Volume > 0;
+    private static string ClipPath(string locale, string id) =>
+        Path.Combine(SanctuaryLocalization.DataPath, "Voice", locale, id + ".wav");
+
+    internal static bool HasRecording(string id)
+    {
+        if (!AuthoredTextProtocol.ValidId(id))
+            return false;
+        string locale = SanctuaryLocalization.Locale;
+        return File.Exists(ClipPath(locale, id)) || locale != "en" && File.Exists(ClipPath("en", id));
+    }
+
+    internal void Play(World world, object owner, string id, string subtitle = null, bool canPlayAudio = true)
+    {
+        Stop();
+        _owner = owner;
+        if (canPlayAudio && Enabled && AuthoredTextProtocol.ValidId(id))
+        {
+            string locale = SanctuaryLocalization.Locale;
+            if (!TryPlay(ClipPath(locale, id)) && locale != "en")
+                TryPlay(ClipPath("en", id));
+        }
+
+        if (!string.IsNullOrWhiteSpace(subtitle) && world.Player is { } avatar)
+        {
+            byte font = Settings.GlobalSettings.ResolveDialogueFont(Client.Game.UO.FileManager.Fonts);
+            _overhead = world.MessageManager.CreateMessage(subtitle, 0x0035, font, true, MessageType.Regular, TextType.OBJECT);
+            if (_clip != null)
+                _overhead.Time = Time.Ticks + (long)Math.Ceiling(_clip.Duration.TotalMilliseconds);
+            avatar.AddMessage(_overhead);
+        }
+
+        if (_clip == null && _overhead == null)
+            _owner = null;
+    }
+
+    private bool TryPlay(string path)
+    {
+        if (!File.Exists(path))
+            return false;
+        SoundEffect clip = null;
+        SoundEffectInstance voice = null;
+        try
+        {
+            using var stream = File.OpenRead(path);
+            clip = SoundEffect.FromStream(stream);
+            voice = clip.CreateInstance();
+            voice.Volume = Volume;
+            voice.Play();
+            _clip = clip;
+            _voice = voice;
+            return true;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException
+            or InvalidOperationException or NotSupportedException or NoAudioHardwareException)
+        {
+            voice?.Dispose();
+            clip?.Dispose();
+            Log.Warn($"Could not play a Sanctuary speech recording: {ex.Message}");
+            return false;
+        }
+    }
+
+    internal void Update()
+    {
+        if (_voice == null)
+            return;
+        if (!Enabled || _voice.State == SoundState.Stopped)
+        {
+            Stop();
+            return;
+        }
+        _voice.Volume = Volume;
+    }
+
+    internal void Stop(object owner = null)
+    {
+        if (owner != null && _owner != owner)
+            return;
+        _voice?.Dispose();
+        _clip?.Dispose();
+        if (_overhead != null && !_overhead.IsDestroyed)
+            _overhead.Time = 0;
+        _voice = null;
+        _clip = null;
+        _overhead = null;
+        _owner = null;
+    }
+}
