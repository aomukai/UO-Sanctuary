+        private void LoadSuccubusAnimations()
+        {
+            ClearResources();
+            string path = Path.Combine(AppContext.BaseDirectory, "Data", "Sanctuary", "Animations", "succubus");
+            var index = new FileInfo(path + ".idx");
+            var data = new FileInfo(path + ".mul");
+            if (!index.Exists || !data.Exists)
+            {
+                return;
+            }
+
+            const int directionCount = (int)HighAnimationGroup.AnimationCount * MAX_DIRECTIONS;
+            if (index.Length != directionCount * sizeof(AnimIdxBlock) || data.Length == 0)
+            {
+                Log.Warn("Invalid Sanctuary succubus animation files");
+                return;
+            }
+
+            var file = new UOFileMul(data.FullName, index.FullName);
+            var directions = ReadMulIndices(file.IdxFile, 0, directionCount);
+            foreach (var direction in directions)
+            {
+                // 512 palette bytes, a frame count, and at least one frame offset.
+                if (direction.Size < 520 || (long)direction.Position + direction.Size > file.Length)
+                {
+                    file.Dispose();
+                    Log.Warn("Invalid Sanctuary succubus animation entry");
+                    return;
+                }
+            }
+
+            _succubusAnimations = file;
+            _succubusDirections = directions;
+        }
