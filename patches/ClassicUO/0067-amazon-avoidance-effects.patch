+
+        internal void BeginAvoidance(ushort graphic)
+        {
+            if (IsDead || FindItemByLayer(Layer.Mount) != null)
+            {
+                return;
+            }
+
+            int turn = graphic == SpellEffectGraphics.DodgeFlash ? 4 : 2;
+            double angle = ((int)(Direction & Direction.Mask) + turn - 1) * Math.PI / 4;
+            _avoidanceOffset = new Vector2((float)(Math.Cos(angle) * 9), (float)(Math.Sin(angle) * 5));
+            _avoidanceStart = Time.Ticks;
+        }
+
+        private Point GetAvoidanceOffset()
+        {
+            uint elapsed = Time.Ticks - _avoidanceStart;
+            if (elapsed >= AvoidanceMilliseconds || IsDead || Steps.Count > 0)
+            {
+                return Point.Zero;
+            }
+
+            double amount = Math.Sin(Math.PI * elapsed / AvoidanceMilliseconds);
+            return new Point((int)Math.Round(_avoidanceOffset.X * amount),
+                (int)Math.Round(_avoidanceOffset.Y * amount));
+        }
