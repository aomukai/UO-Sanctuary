diff --git a/src/ClassicUO.Client/Game/UI/Gumps/SanctuaryResurrectionTheme.cs b/src/ClassicUO.Client/Game/UI/Gumps/SanctuaryResurrectionTheme.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/UI/Gumps/SanctuaryResurrectionTheme.cs
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+using System.Linq;
+using ClassicUO.Game.UI.Controls;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal static class SanctuaryResurrectionTheme
+{
+    // ModernUO's hash of Server.Gumps.ResurrectGump.
+    private const uint ResurrectionGump = 0xA0E1F83A;
+    private const uint Text = 0xD9F0FFFF;
+    private const uint Gold = 0x8AD8FFFF;
+
+    internal static void Apply(Gump gump)
+    {
+        if (!ClassCombatClient.Enabled || gump.ServerSerial != ResurrectionGump)
+            return;
+
+        // Match the free offer. Paid resurrection has its own radio buttons and layout.
+        var controls = gump.Children.ToArray();
+        var background = controls.OfType<ResizePic>().FirstOrDefault(pic => pic.Graphic == 2600
+            && pic.X == 0 && pic.Y == 0 && pic.Width == 400);
+        if (background == null)
+            return;
+
+        Replace(gump, background, new SanctuaryBackdrop("character-frame", 400, 278)
+            { CanCloseWithRightClick = true });
+
+        foreach (var control in controls)
+        {
+            if (control is HtmlControl html)
+            {
+                if (html.Y == 230)
+                    html.Dispose();
+                else
+                    html.ApplySanctuaryColors(html.Y == 20 ? Gold : Text, hideUnusedScrollbar: true);
+            }
+            else if (control is Button { ButtonID: 0 or 1 } button)
+            {
+                int id = button.ButtonID;
+                bool accept = id == 1;
+                int cliloc = accept ? 1011011 : 1011012;
+                string caption = Client.Game.UO.FileManager.Clilocs.GetString(cliloc, true);
+                Replace(gump, button, new SanctuarySheetButton(accept ? 50 : 206, 220, 144,
+                    caption, () => gump.OnButtonClick(id), accept, height: 31));
+            }
+        }
+    }
+
+    private static void Replace(Gump gump, Control original, Control replacement)
+    {
+        gump.Insert(gump.Children.IndexOf(original), replacement);
+        replacement.Page = original.Page;
+        original.Dispose();
+    }
+}
