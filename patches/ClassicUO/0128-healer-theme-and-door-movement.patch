+            else
+                _doorCrossing = playerX < x || playerX == x && direction is Direction.Right or Direction.East or Direction.Down
+                    ? Direction.East : Direction.West;
+        }
+
+        // Route to the threshold first so a path to the far side cannot take another entrance.
+        _throughDoor |= playerX == x && playerY == y && Math.Abs(playerZ - z) < 16;
+        if (_throughDoor && !_doorExit.HasValue)
+        {
+            sbyte exitZ = (sbyte)z;
+            var crossing = _doorCrossing;
+            if (world.Player.Pathfinder.CanWalk(ref crossing, ref x, ref y, ref exitZ))
+                _doorExit = (x, y, exitZ);
+        }
+        if (_doorExit is { } exit)
+            (x, y, z) = exit;
+        return true;
+    }
+
+    private static int OpenDoorFacing(object selected)
+    {
+        if (selected is Item { ItemData.IsDoor: true } door)
