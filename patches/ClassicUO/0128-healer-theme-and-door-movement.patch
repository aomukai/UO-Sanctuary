+        {
+            _groundDoor = null;
+            (x, y, z) = (point.X, point.Y, point.Z);
+            return true;
+        }
+
+        int facing = OpenDoorFacing(selected);
+        if (facing < 0 || selected is not Item door)
+            return false;
+
+        var offset = _doorOffsets[facing];
+        (x, y, z) = (door.X - offset.X, door.Y - offset.Y, door.Z);
+        world.Player.GetEndPosition(out int playerX, out int playerY, out sbyte playerZ, out var direction);
