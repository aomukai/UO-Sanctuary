         public void UpdateTitle(string text)
         {
-            _titleLabel.Text = text;
+            _paperdollTitle = text;
+            _titleLabel.Text = FormatTitle(text);
+        }
+
+        private static string FormatTitle(string text)
+        {
+            if (string.IsNullOrEmpty(text))
+            {
+                return text;
+            }
+
+            int marker = text.LastIndexOf(" Level ", StringComparison.Ordinal);
+            if (marker > 0)
+            {
+                ReadOnlySpan<char> progression = text.AsSpan(marker + 7);
+                int separator = progression.IndexOf(' ');
+                if (separator > 0
+                    && int.TryParse(progression[..separator], out int level) && level > 0
+                    && Enum.TryParse(progression[(separator + 1)..], out DiabloClass characterClass)
+                    && DiabloClasses.TryFromWire((int)characterClass, out _))
+                {
+                    return text[..marker] + "\n" + text[(marker + 1)..];
+                }
+            }
+
+            return text;
         }
 
