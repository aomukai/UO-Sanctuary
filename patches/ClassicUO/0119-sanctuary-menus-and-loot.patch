diff --git a/src/ClassicUO.Client/Game/SanctuaryMenu.cs b/src/ClassicUO.Client/Game/SanctuaryMenu.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/SanctuaryMenu.cs
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: BSD-2-Clause
+
+using ClassicUO.Configuration;
+using ClassicUO.Game.Data;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.Gumps;
+using ClassicUO.Input;
+using SDL3;
+
+namespace ClassicUO.Game;
+
+internal enum SanctuaryWindow
+{
+    Backpack,
+    Character,
+    Journal,
+    WorldMap,
+    Options
+}
+
+internal static class SanctuaryMenu
+{
+    internal const string DefaultKeys = "bcjm";
+
+    internal static bool IsMenuLetter(char key) => key is >= 'a' and <= 'z' and not 's';
+
+    internal static string GetKeys(Profile profile)
+    {
+        string keys = profile.SanctuaryMenuKeys;
+        if (keys?.Length != DefaultKeys.Length)
+            return DefaultKeys;
+
+        for (int i = 0; i < keys.Length; i++)
+            if (!IsMenuLetter(keys[i]) || keys.IndexOf(keys[i]) != i)
+                return DefaultKeys;
+
+        return keys;
+    }
+
+    internal static string Shortcut(SanctuaryWindow window) => window == SanctuaryWindow.Options
+        ? "Esc"
+        : char.ToUpperInvariant(GetKeys(ProfileManager.CurrentProfile)[(int)window]).ToString();
+
+    internal static bool HandleKey(World world, SDL.SDL_KeyboardEvent e)
+    {
+        var chat = UIManager.SystemChat;
+        var focus = UIManager.KeyboardFocusControl;
+        if (!ClassCombatClient.Enabled || UIManager.IsModalOpen || chat == null || chat.IsActive
+            || (focus != null && focus != chat.TextBoxControl))
+            return false;
+
+        var key = (SDL.SDL_Keycode)e.key;
+        bool escape = key == SDL.SDL_Keycode.SDLK_ESCAPE;
+        if (escape && world.TargetManager.IsTargeting)
+            return false;
+
+        bool modified = Keyboard.Ctrl || Keyboard.Alt || Keyboard.Shift || (e.mod & SDL.SDL_Keymod.SDL_KMOD_GUI) != 0;
+        var options = UIManager.GetGump<SanctuaryOptionsGump>();
+        if (options?.IsCapturingKey == true)
+        {
+            if (!e.repeat)
+                options.CaptureKey(key, modified);
+            return true;
+        }
+
+        if (modified)
+            return false;
+
+        int menu = key is >= SDL.SDL_Keycode.SDLK_A and <= SDL.SDL_Keycode.SDLK_Z
+            ? GetKeys(ProfileManager.CurrentProfile).IndexOf((char)key)
+            : -1;
+        if (!escape && menu < 0)
+            return false;
+
+        if (!e.repeat)
+        {
+            if (escape && world.Player.Pathfinder.AutoWalking && world.Player.Pathfinder.PathindingCanBeCancelled)
+                world.Player.Pathfinder.StopAutoWalk();
+            Toggle(world, escape ? SanctuaryWindow.Options : (SanctuaryWindow)menu);
+        }
+        return true;
+    }
+
+    internal static void Toggle(World world, SanctuaryWindow window)
+    {
+        switch (window)
+        {
+            case SanctuaryWindow.Backpack:
+                if (world.Player.FindItemByLayer(Layer.Backpack) is { } backpack)
+                {
+                    if (UIManager.GetGump<ContainerGump>(backpack.Serial) is { } pack)
+                        pack.Dispose();
+                    else
+                        GameActions.OpenBackpack(world);
+                }
+                break;
+            case SanctuaryWindow.Character:
+                if (UIManager.GetGump<PaperDollGump>(world.Player.Serial) is { } paperdoll)
+                    paperdoll.Dispose();
+                else
+                    GameActions.OpenPaperdoll(world, world.Player.Serial);
+                break;
+            case SanctuaryWindow.Journal:
+                if (UIManager.GetGump<SanctuaryJournalGump>() is { } journal)
+                    journal.Dispose();
+                else
+                    SanctuaryJournalGump.Open(world);
+                break;
+            case SanctuaryWindow.WorldMap:
+                if (UIManager.GetGump<WorldMapGump>() is { } map)
+                {
+                    map.Dispose();
+                    ProfileManager.Save(ProfileManager.CurrentProfile, ProfileManager.ProfilePath);
+                }
+                else
+                    GameActions.OpenWorldMap(world);
+                break;
+            case SanctuaryWindow.Options:
+                if (UIManager.GetGump<SanctuaryOptionsGump>() is { } settings)
+                    settings.Dispose();
+                else
+                    GameActions.OpenSettings(world);
+                break;
+        }
+    }
+}
