+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal sealed class SanctuaryOptionsGump : Gump
+{
+    private const int Graphics = 1, Sound = 2, Music = 3, Hotkeys = 4;
+    private const int PanelWidth = 466, PanelHeight = 347;
+    private readonly Profile _profile = ProfileManager.CurrentProfile;
+    private readonly SanctuarySheetButton[] _tabs = new SanctuarySheetButton[4];
+    private readonly SanctuarySheetButton[] _bindings = new SanctuarySheetButton[4];
+    private readonly Label _keyHint;
+    private string _keys;
+    private int _capturing = -1;
+
+    private bool _borderless, _drawRoofs, _highlightObjects;
+    private bool _sound, _footsteps, _music, _combatMusic, _loginMusic;
+    private readonly ValueSlider _fps, _worldZoom, _screenScale, _soundsVolume, _musicVolume, _loginVolume;
+
+    private SanctuaryOptionsGump(World world, bool hotkeys) : base(world, 0, 0)
+    {
+        Width = PanelWidth;
+        Height = PanelHeight;
+        Recenter();
+        CanMove = CanCloseWithRightClick = true;
+        Add(new SanctuaryBackdrop("character-frame", Width, Height) { CanCloseWithRightClick = true });
+        AddText("Options", 24, 16);
+
+        string[] tabs = ["Graphics", "Sound", "Music", "Hotkeys"];
+        for (int i = 0; i < tabs.Length; i++)
+        {
+            int page = i + 1;
+            _tabs[i] = Add(new SanctuarySheetButton(23 + i * 106, 45, 103, tabs[i], () => SelectTab(page)));
+        }
+
+        Add(new Line(23, 81, 420, 1, 0xFF486581) { AcceptMouseInput = false });
+        Add(new Line(23, 300, 420, 1, 0xFF486581) { AcceptMouseInput = false });
+        Add(new SanctuarySheetButton(23, 310, 75, "Help", () => SanctuaryHelpGump.Open(World)));
+        Add(new SanctuarySheetButton(270, 310, 82, "Cancel", Dispose));
+        Add(new SanctuarySheetButton(360, 310, 83, "Apply", Apply, primary: true));
+
+        var camera = Client.Game.Scene.Camera;
+        AddToggle("Borderless window", Graphics, 0, _profile.WindowBorderless, value => _borderless = value);
+        _fps = AddSlider("Frame rate limit", Graphics, 1, Constants.MIN_FPS, Constants.MAX_FPS, Settings.GlobalSettings.FPS, " fps");
+        _worldZoom = AddSlider("World zoom", Graphics, 2, (int)Math.Round(100 / camera.ZoomMax),
+            (int)Math.Round(100 / camera.ZoomMin), (int)Math.Round(100 / camera.Zoom), "%");
+        _screenScale = AddSlider("Interface scale", Graphics, 3, 50, 200, (int)Math.Round(100 * Client.Game.ScreenScale), "%");
+        AddToggle("Show roofs", Graphics, 4, _profile.DrawRoofs, value => _drawRoofs = value);
+        AddToggle("Highlight objects on hover", Graphics, 5, _profile.HighlightGameObjects, value => _highlightObjects = value);
+
+        AddToggle("Sound effects", Sound, 0, _profile.EnableSound, value => _sound = value);
+        _soundsVolume = AddSlider("Effects volume", Sound, 1, 0, 100, _profile.SoundVolume, "%");
+        AddToggle("Footsteps", Sound, 2, _profile.EnableFootstepsSound, value => _footsteps = value);
+
+        AddToggle("Game music", Music, 0, _profile.EnableMusic, value => _music = value);
+        _musicVolume = AddSlider("Music volume", Music, 1, 0, 100, _profile.MusicVolume, "%");
+        AddToggle("Combat music", Music, 2, _profile.EnableCombatMusic, value => _combatMusic = value);
+        AddToggle("Login music", Music, 3, Settings.GlobalSettings.LoginMusic, value => _loginMusic = value);
+        _loginVolume = AddSlider("Login music volume", Music, 4, 0, 100, Settings.GlobalSettings.LoginMusicVolume, "%");
+
+        _keys = SanctuaryMenu.GetKeys(_profile);
+        string[] windows = ["Backpack", "Character", "Journal", "World map"];
+        for (int i = 0; i < windows.Length; i++)
+        {
+            int binding = i;
+            int y = Row(i);
+            AddText(windows[i], 30, y + 4, Hotkeys);
+            _bindings[i] = Add(new SanctuarySheetButton(345, y, 92, "", () =>
+            {
+                _capturing = binding;
+                RefreshBindings("Press a letter. Esc cancels.");
+            }), Hotkeys);
+        }
+
+        AddText("Esc  Options     Enter  Chat     Tab  Run/Walk", 30, 240, Hotkeys);
+        AddText("S  Skill bindings     F1–F12  Skills     1–4  Belt", 30, 263, Hotkeys);
+        Add(new SanctuarySheetButton(106, 310, 92, "Defaults", () =>
+        {
+            _keys = SanctuaryMenu.DefaultKeys;
+            _capturing = -1;
+            RefreshBindings();
+        }), Hotkeys);
+        _keyHint = AddText("", 30, 282, Hotkeys);
+        SelectTab(hotkeys ? Hotkeys : Graphics);
+    }
+
+    public bool IsCapturingKey => _capturing >= 0;
+
+    public static void Open(World world, bool hotkeys)
+    {
+        if (UIManager.GetGump<SanctuaryOptionsGump>() is { } options)
+        {
+            if (hotkeys)
+                options.SelectTab(Hotkeys);
+            options.SetInScreen();
+            options.BringOnTop();
+        }
+        else
+        {
+            UIManager.Add(new SanctuaryOptionsGump(world, hotkeys));
+        }
+    }
+
+    public void CaptureKey(SDL.SDL_Keycode key, bool modified)
+    {
+        if (key == SDL.SDL_Keycode.SDLK_ESCAPE)
+        {
+            _capturing = -1;
+            RefreshBindings();
+            return;
+        }
+
+        if (modified || key < SDL.SDL_Keycode.SDLK_A || key > SDL.SDL_Keycode.SDLK_Z
+            || !SanctuaryMenu.IsMenuLetter((char)key))
+        {
+            RefreshBindings("Use an unmodified letter. S opens skill bindings.");
+            return;
+        }
+
+        char letter = (char)key;
+        int taken = _keys.IndexOf(letter);
+        if (taken >= 0 && taken != _capturing)
+        {
+            RefreshBindings("That letter is assigned to another window.");
+            return;
+        }
+
+        _keys = _keys[.._capturing] + letter + _keys[(_capturing + 1)..];
+        _capturing = -1;
+        RefreshBindings();
+    }
+
+    private void RefreshBindings(string hint = "")
+    {
+        for (int i = 0; i < _bindings.Length; i++)
+        {
+            _bindings[i].SetCaption(i == _capturing ? "Press a key" : char.ToUpperInvariant(_keys[i]).ToString());
+            _bindings[i].SetPrimary(i == _capturing);
+        }
+        _keyHint.Text = hint;
+    }
+
+    private void SelectTab(int page)
+    {
+        _capturing = -1;
+        RefreshBindings();
+        for (int i = 0; i < _tabs.Length; i++)
+            _tabs[i].SetPrimary(i + 1 == page);
+        ChangePage(page);
+    }
+
+    private static int Row(int row) => 93 + row * 33;
+
+    private Label AddText(string text, int x, int y, int page = 0) =>
+        Add(new Label(text, true, 0x0481, font: 1) { X = x, Y = y, AcceptMouseInput = false }, page);
+
+    private void AddToggle(string title, int page, int row, bool value, Action<bool> set)
+    {
+        int y = Row(row);
+        AddText(title, 30, y + 4, page);
+        SanctuarySheetButton button = null;
+        button = Add(new SanctuarySheetButton(345, y, 92, value ? "On" : "Off", () =>
+        {
+            value = !value;
+            set(value);
+            button.SetCaption(value ? "On" : "Off");
+            button.SetPrimary(value);
+        }, value), page);
+        set(value);
+    }
+
+    private ValueSlider AddSlider(string title, int page, int row, int min, int max, int value, string suffix)
+    {
+        int y = Row(row);
+        AddText(title, 30, y + 4, page);
+        return Add(new ValueSlider(203, y, min, max, value, suffix), page);
+    }
+
+    private void Recenter()
+    {
+        X = Math.Max(0, (Client.Game.ClientBounds.Width - Width) / 2);
+        Y = Math.Max(0, (Client.Game.ClientBounds.Height - Height) / 2);
+    }
+
+    private void Apply()
+    {
+        var settings = Settings.GlobalSettings;
+        var game = Client.Game;
+
+        if (_profile.WindowBorderless != _borderless)
+        {
+            _profile.WindowBorderless = _borderless;
+            game.SetWindowBorderless(_borderless);
+        }
+        if (_profile.DrawRoofs != _drawRoofs)
+        {
+            _profile.DrawRoofs = _drawRoofs;
+            game.GetScene<GameScene>()?.UpdateMaxDrawZ(true);
+        }
+        _profile.HighlightGameObjects = _highlightObjects;
+        if (_fps.Changed)
+            game.SetRefreshRate(_fps.Value);
+        if (_worldZoom.Changed)
+            _profile.DefaultScale = game.Scene.Camera.Zoom = 100f / _worldZoom.Value;
+        if (_screenScale.Changed)
+            game.ScreenScale = settings.ScreenScale = _screenScale.Value / 100f;
+
+        bool resumeMusic = !_profile.EnableMusic && _music;
+        _profile.EnableSound = _sound;
+        _profile.SoundVolume = _soundsVolume.Value;
+        _profile.EnableFootstepsSound = _footsteps;
+        _profile.EnableMusic = _music;
+        _profile.MusicVolume = _musicVolume.Value;
+        if (_profile.EnableCombatMusic && !_combatMusic && _music)
+            resumeMusic = true;
+        _profile.EnableCombatMusic = _combatMusic;
+        settings.LoginMusic = _loginMusic;
+        settings.LoginMusicVolume = _loginVolume.Value;
+
+        game.Audio.UpdateCurrentSoundsVolume();
+        game.Audio.UpdateCurrentMusicVolume();
+        if (!_sound)
+            game.Audio.StopSounds();
+        if (!_music)
+            game.Audio.StopMusic();
+        else if (resumeMusic)
+            game.Audio.StopWarMusic();
+
+        if (_profile.SanctuaryMenuKeys != _keys)
+        {
+            _profile.SanctuaryMenuKeys = _keys;
+            UIManager.GetGump<ClassSkillBarGump>()?.RequestUpdateContents();
+            UIManager.GetGump<SanctuaryHelpGump>()?.RefreshShortcuts();
+        }
+        ProfileManager.Save(_profile, ProfileManager.ProfilePath);
+        settings.Save();
+        Dispose();
+    }
+
+    private sealed class ValueSlider : Control
+    {
+        private const int Track = 165;
+        private readonly int _min, _max, _original;
+        private readonly Line _fill;
+        private readonly Label _caption;
+        private readonly string _suffix;
+        private bool _dragging;
+
+        public ValueSlider(int x, int y, int min, int max, int value, string suffix)
+        {
+            X = x;
+            Y = y;
+            Width = 234;
+            Height = 25;
+            AcceptMouseInput = true;
+            WantUpdateSize = false;
+            _min = min;
+            _max = max;
+            _suffix = suffix;
+            Add(new Line(0, 7, Track, 11, 0xFF486581) { AcceptMouseInput = false });
+            Add(new Line(1, 8, Track - 2, 9, 0xFF211C22) { AcceptMouseInput = false });
+            _fill = Add(new Line(1, 8, 0, 9, 0xFF639AD0) { AcceptMouseInput = false });
+            _caption = Add(new Label("", true, 0x0481, font: 1) { Y = 4, AcceptMouseInput = false });
+            SetValue(_original = Math.Clamp(value, min, max));
+        }
+
+        public int Value { get; private set; }
+        public bool Changed => Value != _original;
+
+        public override void Update()
+        {
+            base.Update();
+            if (_dragging && Mouse.LButtonPressed)
+                SetFromPosition(Mouse.Position.X - ScreenCoordinateX);
+            else
+                _dragging = false;
+        }
+
+        protected override void OnMouseDown(int x, int y, MouseButtonType button)
+        {
+            if (button == MouseButtonType.Left && x < Track)
+            {
+                _dragging = true;
+                SetFromPosition(x);
+            }
+        }
+
+        protected override void OnMouseWheel(MouseEventType delta) =>
+            SetValue(Value + (delta == MouseEventType.WheelScrollUp ? 1 : -1));
+
+        private void SetFromPosition(int x) =>
+            SetValue(_min + (int)Math.Round((double)x * (_max - _min) / (Track - 1)));
+
+        private void SetValue(int value)
+        {
+            Value = Math.Clamp(value, _min, _max);
+            _fill.Width = (Track - 2) * (Value - _min) / Math.Max(1, _max - _min);
+            _caption.Text = Value + _suffix;
+            _caption.X = Width - _caption.Width;
+        }
+    }
+}
