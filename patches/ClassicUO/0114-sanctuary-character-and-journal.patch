+// SPDX-License-Identifier: BSD-2-Clause
+
+using System;
+using System.Collections.Generic;
+using ClassicUO.Game.UI.Controls;
+using ClassicUO.Input;
+using Sanctuary;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal sealed class SanctuaryCharacterStats : Control
+{
+    private const ushort TextHue = 0x0481;
+    private readonly World _world;
+    private readonly List<(Label Label, int Right, Func<string> Value)> _rows = new();
+    private readonly List<Label> _spend = new();
+    private uint _refresh;
+
+    public SanctuaryCharacterStats(World world)
+    {
+        _world = world;
+        AcceptMouseInput = false;
+        WantUpdateSize = false;
+        var player = world.Player;
+
+        const int left = 244, right = 432;
+        Heading(left, 70, "Attributes");
+        Attribute(left, 98, "Strength", StatField.Strength, () => player.Strength,
+            "Weapon damage, equipment requirements and carrying capacity.");
+        Attribute(left, 117, "Dexterity", StatField.Dexterity, () => player.Dexterity,
+            "Attack rating and defense. Helps bows, throwing weapons and daggers.");
+        Attribute(left, 136, "Energy", StatField.Energy, () => player.Intelligence, "Increases mana.");
+        Attribute(left, 155, "Vitality", StatField.Vitality, () => null, "Increases life and stamina.");
+        Row(left, 174, "Unspent points", () => ClassValue(StatField.Points));
+
+        Heading(left, 207, "Resources");
+        Row(left, 232, "Life", () => $"{player.Hits} / {player.HitsMax}");
+        Row(left, 252, "Mana", () => $"{player.Mana} / {player.ManaMax}");
+        Row(left, 272, "Stamina", () => $"{player.Stamina} / {player.StaminaMax}");
+        Row(left, 292, "Weight", () => $"{player.Weight} / {player.WeightMax}");
+        Row(left, 312, "Followers", () => $"{player.Followers} / {player.FollowersMax}");
+        Row(left, 332, "Gold", () => player.Gold.ToString());
+
+        Heading(right, 70, "Combat");
+        Row(right, 98, "Attack damage", () => ClassStatsClient.Ready
+            ? $"{ClassStatsClient.Get(StatField.DamageMin)}–{ClassStatsClient.Get(StatField.DamageMax)}"
+            : $"{player.DamageMin}–{player.DamageMax}");
+        Row(right, 117, "Attack rating", () => ClassValue(StatField.AttackRating));
+        Row(right, 136, "Defense", () => ClassValue(StatField.Defense));
+        Row(right, 155, "Attack speed", () => ClassValue(StatField.Ias, "%"));
+        Row(right, 174, "Cast rate", () => ClassValue(StatField.Fcr, "%"));
+        Row(right, 193, "Magic find", () => ClassValue(StatField.MagicFind, "%"));
+
+        Heading(right, 225, "Resistances");
+        Row(right, 250, "Physical", () => $"{player.PhysicalResistance} / {player.MaxPhysicResistence}");
+        Row(right, 270, "Fire", () => $"{player.FireResistance} / {player.MaxFireResistence}");
+        Row(right, 290, "Cold", () => $"{player.ColdResistance} / {player.MaxColdResistence}");
+        Row(right, 310, "Poison", () => $"{player.PoisonResistance} / {player.MaxPoisonResistence}");
+        Row(right, 330, "Lightning", () => $"{player.EnergyResistance} / {player.MaxEnergyResistence}");
+        Refresh();
+    }
+
+    private static string ClassValue(StatField stat, string suffix = "") =>
+        ClassStatsClient.Ready ? ClassStatsClient.Get(stat) + suffix : "—";
+
+    private void Heading(int x, int y, string name)
+    {
+        Add(new Label(name, true, TextHue, font: 0) { X = x, Y = y });
+        Add(new Line(x, y + 21, 158, 1, 0xFF406989) { AcceptMouseInput = false });
+    }
+
+    private void Row(int x, int y, string name, Func<string> read, int width = 158)
+    {
+        Add(new Label(name, true, TextHue, font: 1) { X = x, Y = y });
+        var value = Add(new Label("", true, TextHue, font: 1) { Y = y });
+        _rows.Add((value, x + width, read));
+    }
+
+    private void Attribute(int x, int y, string name, StatField stat, Func<int?> fallback, string tooltip)
+    {
+        Row(x, y, name, () => ClassStatsClient.Ready ? ClassValue(stat) : fallback()?.ToString() ?? "—", 132);
+        var plus = Add(new Label("+", true, 0x0035, font: 1) { X = x + 146, Y = y });
+        var hit = Add(new HitBox(x, y - 2, 158, 18, tooltip, 0.06f));
+        hit.MouseUp += (_, args) =>
+        {
+            if (args.Button == MouseButtonType.Left && !_world.TargetManager.IsTargeting && !_world.Player.IsDead
+                && !Client.Game.UO.GameCursor.ItemHold.Enabled)
+            {
+                ClassStatsClient.Spend((CharacterStat)stat);
+                Mouse.CancelDoubleClick = true;
+            }
+        };
+        _spend.Add(plus);
+    }
+
+    public override void Update()
+    {
+        if (unchecked((int)(Time.Ticks - _refresh)) >= 0)
+            Refresh();
+        base.Update();
+    }
+
+    private void Refresh()
+    {
+        _refresh = Time.Ticks + 200;
+        foreach (var (label, right, value) in _rows)
+        {
+            string text = value();
+            if (label.Text != text)
+                label.Text = text;
+            label.X = right - label.Width;
+        }
+
+        bool canSpend = ClassStatsClient.Ready && ClassStatsClient.Get(StatField.Points) > 0 && !_world.Player.IsDead;
+        foreach (var control in _spend)
+            control.IsVisible = canSpend;
+    }
+}
