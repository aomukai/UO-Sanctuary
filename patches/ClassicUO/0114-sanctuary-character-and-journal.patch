+
+internal sealed class SanctuaryBackdrop : Control
+{
+    private readonly Texture2D _texture;
+
+    public SanctuaryBackdrop(string name, int width, int height)
+    {
+        using var stream = typeof(SanctuaryBackdrop).Assembly.GetManifestResourceStream($"Sanctuary.UI.{name}.png")
+            ?? throw new InvalidOperationException($"Missing Sanctuary UI texture: {name}");
+        _texture = Texture2D.FromStream(Client.Game.GraphicsDevice, stream);
+        Width = width;
+        Height = height;
+        AcceptMouseInput = CanMove = true;
+        WantUpdateSize = false;
+    }
+
+    public override bool AddToRenderLists(RenderLists lists, int x, int y, ref float depth)
+    {
+        var bounds = new Rectangle(x, y, Width, Height);
+        float layer = depth;
+        lists.AddGumpNoAtlas(batcher =>
+        {
+            batcher.Draw(_texture, bounds, ShaderHueTranslator.GetHueVector(0), layer);
+            return true;
+        });
+        return true;
+    }
+
+    public override void Dispose()
+    {
+        if (!IsDisposed)
+            _texture.Dispose();
+        base.Dispose();
+    }
+}
+
+internal sealed class SanctuarySheetButton : Control
+{
+    private readonly Label _label;
+    private readonly Action _activate;
+
+    public SanctuarySheetButton(int x, int y, int width, string text, Action activate, bool primary = false)
+    {
+        X = x;
+        Y = y;
+        Width = width;
+        Height = 25;
+        AcceptMouseInput = true;
+        WantUpdateSize = false;
+        _activate = activate;
+        Add(new Line(0, 0, width, Height, 0xFF557B98) { AcceptMouseInput = false });
+        Add(new Line(1, 1, width - 2, Height - 2, primary ? 0xFF335C77u : 0xFF292D42u) { AcceptMouseInput = false });
+        _label = Add(new Label("", true, 0x481, font: 1));
+        SetCaption(text);
+    }
+
+    public void SetCaption(string text)
+    {
+        if (_label.Text == text)
+            return;
+
+        _label.Text = text;
+        _label.X = (Width - _label.Width) / 2;
+        _label.Y = (Height - _label.Height) / 2;
+    }
+
+    protected override void OnMouseUp(int x, int y, MouseButtonType button)
+    {
+        if (button == MouseButtonType.Left && MouseIsOver)
+        {
+            _activate();
+            Mouse.CancelDoubleClick = true;
+        }
+        base.OnMouseUp(x, y, button);
+    }
+}
