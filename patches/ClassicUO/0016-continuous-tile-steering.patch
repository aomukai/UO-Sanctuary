+        private bool TryDirectPath(long started)
+        {
+            int dx = _endPoint.X - _startPoint.X;
+            int dy = _endPoint.Y - _startPoint.Y;
+            int length = Math.Max(Math.Abs(dx), Math.Abs(dy));
+            if (length == 0 || length >= _directPath.Length)
+            {
+                return false;
+            }
+
+            // Distribute the two nearest legal step directions along the line.
+            // Every edge still passes the native height and corner checks.
+            int x = _startPoint.X, y = _startPoint.Y;
+            sbyte z = _startZ;
+            for (int i = 0; i <= length; i++)
+            {
+                int direction = 0;
+                if (i > 0)
+                {
+                    int nextX = _startPoint.X + Math.Sign(dx) * ((Math.Abs(dx) * i + length / 2) / length);
+                    int nextY = _startPoint.Y + Math.Sign(dy) * ((Math.Abs(dy) * i + length / 2) / length);
+                    while (_offsetX[direction] != nextX - x || _offsetY[direction] != nextY - y)
+                    {
+                        direction++;
+                    }
+                    Direction want = (Direction)direction;
+                    Direction actual = want;
+                    if (!CanWalk(ref actual, ref x, ref y, ref z) || actual != want || x != nextX || y != nextY)
+                    {
+                        return false;
+                    }
+                }
+
+                var node = _directPath[i] ??= new PathNode();
+                node.X = x;
+                node.Y = y;
+                node.Z = z;
+                node.Direction = direction;
+                _path[i] = node;
+
+                if (i > 0 && MathHelper.GetDistance(_endPoint, new Point(x, y)) <= _pathfindDistance && Math.Abs(z - _destinationZ) < 16)
+                {
+                    _pathSize = i + 1;
+                    _goalFound = true;
+                    return true;
+                }
+                if (Stopwatch.GetElapsedTime(started).TotalMilliseconds >= RESPONSIVE_BUDGET_MS)
+                {
+                    return false;
+                }
+            }
+            return false;
+        }
