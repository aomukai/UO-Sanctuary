+        private void ProcessResponsiveStep(PathNode node)
+        {
+            var player = _world.Player;
+            player.GetEndPosition(out int x, out int y, out _, out Direction direction);
+            if (Math.Abs(node.X - x) > 1 || Math.Abs(node.Y - y) > 1 || node.X == x && node.Y == y)
+            {
+                if (TraceMovement)
+                {
+                    Log.Trace($"Movement route stopped: non-adjacent node from={x},{y} to={node.X},{node.Y}");
+                }
+                StopAutoWalk();
+                return;
+            }
+
+            // A cheaper A* parent can change a node's incoming direction.
+            int next = 0;
+            while (_offsetX[next] != node.X - x || _offsetY[next] != node.Y - y)
+            {
+                next++;
+            }
+            Direction pathDirection = (Direction)next;
+            bool turning = (direction & Direction.Mask) != pathDirection;
+            if (!player.Walk(pathDirection, _run))
+            {
+                StopAutoWalk();
+                return;
+            }
+
+            player.GetEndPosition(out int nextX, out int nextY, out sbyte nextZ, out Direction nextDirection);
+            if (turning && nextX == x && nextY == y && (nextDirection & Direction.Mask) == pathDirection
+                && player.Walker.UnacceptedPacketsCount < 3 && player.Walker.StepsCount < Constants.MAX_STEP_COUNT)
+            {
+                // A protocol turn costs no movement time. Pair only one turn and
+                // one step, after the preceding step's normal request deadline.
+                player.Walker.LastStepRequestTime = Time.Ticks;
+                if (!player.Walk(pathDirection, _run))
+                {
+                    StopAutoWalk();
+                    return;
+                }
+                player.GetEndPosition(out nextX, out nextY, out nextZ, out _);
+            }
+
+            if (nextX == node.X && nextY == node.Y && nextZ == node.Z)
+            {
+                _pointIndex++;
+            }
+            else if (nextX != x || nextY != y)
+            {
+                StopAutoWalk();
             }
         }
 
