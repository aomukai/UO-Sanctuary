--- a/src/ClassicUO.Client/Game/AvatarDialogueClient.cs
+++ b/src/ClassicUO.Client/Game/AvatarDialogueClient.cs
@@ -105,16 +105,20 @@
         }
         if (kind == PortraitProtocol.BritainDiscoveries && reader.Remaining == 1)
         {
-            world.Player.SanctuaryDiscoveries = (StoryDiscoveries)(((uint)world.Player.SanctuaryDiscoveries & ~0xFFu)
+            world.Player.SanctuaryDiscoveries = (StoryDiscoveries)(((ulong)world.Player.SanctuaryDiscoveries & ~0xFFUL)
                 | reader.ReadUInt8());
             UIManager.GetGump<SanctuaryJournalGump>()?.RefreshDiscoveries();
             return;
         }
-        if (kind == PortraitProtocol.WorldDiscoveries && reader.Remaining is 2 or 4)
+        if (kind == PortraitProtocol.WorldDiscoveries && reader.Remaining is 2 or 4 or 8)
         {
-            world.Player.SanctuaryDiscoveries = (StoryDiscoveries)(reader.Remaining == 4
-                ? reader.ReadUInt32BE()
-                : ((uint)world.Player.SanctuaryDiscoveries & ~0xFFFFu) | reader.ReadUInt16BE());
+            ulong known = (ulong)world.Player.SanctuaryDiscoveries;
+            world.Player.SanctuaryDiscoveries = (StoryDiscoveries)(reader.Remaining switch
+            {
+                8 => reader.ReadUInt64BE(),
+                4 => (known & ~0xFFFFFFFFUL) | reader.ReadUInt32BE(),
+                _ => (known & ~0xFFFFUL) | reader.ReadUInt16BE()
+            });
             UIManager.GetGump<SanctuaryJournalGump>()?.RefreshDiscoveries();
             return;
         }
