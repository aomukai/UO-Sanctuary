+    public static bool TryAim(World world, out ushort x, out ushort y, out sbyte z)
+    {
+        x = y = 0; z = 0;
+        if (!world.InGame || !Client.Game.IsActive || !UIManager.IsMouseOverWorld || world.TargetManager.IsTargeting
+            || Client.Game.UO.GameCursor.ItemHold.Enabled || SelectedObject.Object is not GameObject point) { return false; }
+        int height = point.Z;
+        if (point is Land land) { height = land.IsStretched ? land.AverageZ : land.Z; }
+        else if (point is Static tile && tile.ItemData.IsSurface) { height += tile.ItemData.IsBridge ? tile.ItemData.Height / 2 : tile.ItemData.Height; }
+        else if (point is Item item && item.ItemData.IsSurface) { height += item.ItemData.IsBridge ? item.ItemData.Height / 2 : item.ItemData.Height; }
+        if (height is < -128 or > 127) { return false; }
+        x = point.X; y = point.Y; z = (sbyte)height; return true;
+    }
+    public static bool UseInventoryScroll(World world, uint serial)
+    {
