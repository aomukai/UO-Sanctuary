diff --git a/src/ClassicUO.Client/Game/GameObjects/Views/GameEffectView.cs b/src/ClassicUO.Client/Game/GameObjects/Views/GameEffectView.cs
--- a/src/ClassicUO.Client/Game/GameObjects/Views/GameEffectView.cs
+++ b/src/ClassicUO.Client/Game/GameObjects/Views/GameEffectView.cs
@@ -148,6 +148,21 @@
 
             Vector3 hueVec = ShaderHueTranslator.GetHueVector(hue, data.IsPartialHue, data.IsTranslucent ? .5f : 1f, effect: true);
 
+            if (SpellEffectGraphics.IsDruidCharge(Graphic) && Source is Mobile shifter)
+            {
+                if (shifter.IsDead) { return false; }
+                bool maul = Graphic < SpellEffectGraphics.DruidFeralCharge;
+                const int period = 1560;
+                float phase = (Time.Ticks + shifter.Serial * 13L) % period * (MathHelper.TwoPi / period);
+                float side = MathF.Sin(phase);
+                posX += (int)MathF.Round(MathF.Cos(phase) * (maul ? 39 : 32));
+                posY += (int)MathF.Round(side * 13) - (maul ? 30 : 20);
+                // The outer arc crosses in front of the displayed creature.
+                depth = shifter.CalculateDepthZ() + (side >= 0 ? 1f : -1f);
+                DrawStaticRotated(batcher, AnimationGraphic, posX, posY, 0, hueVec, depth);
+                return true;
+            }
+
             if (Graphic is Sanctuary.SpellEffectGraphics.StaticFieldSmall or Sanctuary.SpellEffectGraphics.StaticFieldMedium
                 or Sanctuary.SpellEffectGraphics.StaticFieldLarge or Sanctuary.SpellEffectGraphics.FrostNovaRing
                 or Sanctuary.SpellEffectGraphics.NovaRing)
