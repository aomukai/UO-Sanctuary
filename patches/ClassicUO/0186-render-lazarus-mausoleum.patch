+        private static Point MausoleumArtOrigin(Item tile)
+        {
+            int dx = WorldDecorationGraphics.MausoleumX + WorldDecorationGraphics.MausoleumMid - tile.X;
+            int dy = WorldDecorationGraphics.MausoleumY + WorldDecorationGraphics.MausoleumMid - tile.Y;
+            int x = tile.RealScreenPosition.X + 22 + (dx - dy) * 22;
+            int y = tile.RealScreenPosition.Y + 22 + (dx + dy) * 22;
+            return new Point(x - 1960, y - 3760);
