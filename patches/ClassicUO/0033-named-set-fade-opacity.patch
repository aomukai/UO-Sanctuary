@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using ClassicUO.IO;
+using System;
+using System.IO;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class NamedVisualsClient
+{
+    private static readonly string _trace = Environment.GetEnvironmentVariable("SANCTUARY_NAMED_VISUAL_TRACE");
+    public static void Receive(World world, ref StackDataReader reader)
+    {
+        if (!world.InGame || reader.Remaining != 6 || reader.ReadUInt8() != NamedVisualProtocol.Version)
+        {
+            return;
+        }
+        uint serial = reader.ReadUInt32BE();
+        byte opacity = reader.ReadUInt8();
+        if (opacity is not (NamedVisualProtocol.Faded or NamedVisualProtocol.Opaque))
+        {
+            return;
+        }
+        if (world.Mobiles.TryGetValue(serial, out var mobile))
+        {
+            mobile.NamedOpacity = opacity;
+            if (_trace != null)
+            {
+                File.WriteAllText(_trace, $"{serial} {opacity}");
+            }
+        }
+    }
+}
