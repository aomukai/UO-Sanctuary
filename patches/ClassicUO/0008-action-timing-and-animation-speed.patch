+        if (unchecked((int)(Time.Ticks - _nextAnimationCleanup)) < 0)
+        {
+            return;
+        }
+        _nextAnimationCleanup = Time.Ticks + 200;
+        _expiredAnimations.Clear();
+        foreach (var (serial, lease) in _animations)
+        {
+            if (unchecked((int)(Time.Ticks - lease.Until)) >= 0)
+            {
+                _expiredAnimations.Add(serial);
+            }
+        }
+        foreach (uint serial in _expiredAnimations)
+        {
+            _animations.Remove(serial);
