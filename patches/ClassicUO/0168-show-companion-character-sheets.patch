+    internal static void ReceiveCompanion(World world, ref StackDataReader reader)
+    {
+        if (!world.InGame || world.Player == null || reader.Remaining != CompanionStatProtocol.SnapshotLength - 5
+            || reader.ReadUInt8() != CompanionStatProtocol.Version)
+            return;
+
+        uint serial = reader.ReadUInt32BE();
+        if (serial != world.Player.SanctuaryStoryCompanion || UIManager.GetGump<PaperDollGump>(serial) is not { } gump)
+            return;
+
+        var style = (CompanionEquipmentStyle)reader.ReadUInt8();
+        if (!Enum.IsDefined(style))
+            return;
+        var values = new int[CompanionStatProtocol.Values];
+        for (int i = 0; i < values.Length; i++)
+            values[i] = reader.ReadInt32BE();
+        gump.SetCompanionStats(style, values);
+    }
+
+    internal void SetCompanionStats(CompanionEquipmentStyle style, int[] values)
+    {
+        if (_lastCompanionUpdate == 0 && style == CompanionEquipmentStyle.Bow)
+        {
+            Heading(CompanionAttributesX, 277, "Avoidance");
+            Row(CompanionAttributesX, 302, "Dodge", () => CompanionValue(CompanionStatField.DodgeChance, "%"));
+            Row(CompanionAttributesX, 321, "Avoid", () => CompanionValue(CompanionStatField.AvoidChance, "%"));
+            Row(CompanionAttributesX, 340, "Evade", () => CompanionValue(CompanionStatField.EvadeChance, "%"));
+        }
+        _companionStats = (style, values);
+        _lastCompanionUpdate = Time.Ticks;
+        Refresh();
+    }
+
+    private void PollCompanion()
+    {
+        if (!IsVisible || !_world.InGame || unchecked((int)(Time.Ticks - _nextCompanionPoll)) < 0)
+            return;
+
+        _nextCompanionPoll = Time.Ticks + StatProtocol.PollMs;
+        if (unchecked((int)(Time.Ticks - _lastCompanionUpdate)) >= StatProtocol.PollMs * 3)
+            _companionStats = null;
+
+        RequestCompanion(_companion, CompanionStatRequest.Snapshot);
+    }
+
+    internal static void RequestCompanion(uint serial, CompanionStatRequest request)
+    {
+        using var writer = new StackDataWriter(CompanionStatProtocol.RequestLength);
+        writer.WriteUInt8(0xBF);
+        writer.WriteUInt16BE(CompanionStatProtocol.RequestLength);
+        writer.WriteUInt16BE(CompanionStatProtocol.SubCommand);
+        writer.WriteUInt8(CompanionStatProtocol.Version);
+        writer.WriteUInt8((byte)request);
+        writer.WriteUInt32BE(serial);
+        NetClient.Socket.Send(writer.BufferWritten);
+    }
