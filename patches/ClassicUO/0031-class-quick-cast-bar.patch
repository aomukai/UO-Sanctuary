diff --git a/src/ClassicUO.Client/Game/ClassSkillBindingsClient.cs b/src/ClassicUO.Client/Game/ClassSkillBindingsClient.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/ClassSkillBindingsClient.cs
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using System;
+using ClassicUO.Game.Managers;
+using ClassicUO.Game.UI.Gumps;
+using ClassicUO.IO;
+using ClassicUO.Network;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class ClassSkillBindingsClient
+{
+    private static readonly CombatAbility[] _quick = new CombatAbility[SkillBindingProtocol.Slots];
+    private static uint _sequence, _nextPoll, _available;
+    public static DiabloClass Class { get; private set; }
+    public static CombatAbility Left { get; private set; }
+    public static CombatAbility Right { get; private set; }
+    public static bool Ready { get; private set; }
+    public static bool Available(CombatAbility ability) => ability == CombatAbility.None || ability <= CombatAbility.Teleport && (_available & 1U << (int)ability) != 0;
+    public static CombatAbility Quick(int slot) => _quick[slot];
+    public static void Reset()
+    {
+        Array.Clear(_quick); _sequence = _available = 0; _nextPoll = Time.Ticks; Ready = false; Class = default;
+        UIManager.GetGump<ClassSkillBarGump>()?.Dispose(); UIManager.GetGump<ClassSkillsPanelGump>()?.Dispose();
+    }
+    public static void Update(World world)
+    {
+        if (!ClassCombatClient.Enabled) { return; }
+        if (Ready && UIManager.GetGump<ClassSkillBarGump>() == null) { UIManager.Add(new ClassSkillBarGump(world)); }
+        if (unchecked((int)(Time.Ticks - _nextPoll)) >= 0)
+        { _nextPoll = Time.Ticks + SkillBindingProtocol.PollMs; Send(SkillBindingRequest.Poll); }
+    }
+    public static void TogglePanel(World world)
+    {
+        if (!Ready) { return; }
+        if (UIManager.GetGump<ClassSkillsPanelGump>() is { } panel) { panel.Dispose(); }
+        else { UIManager.Add(new ClassSkillsPanelGump(world)); }
+    }
+    public static void Key(World world, int slot)
+    {
+        if (!Ready) { return; }
+        if (UIManager.GetGump<ClassSkillsPanelGump>()?.Hovered is { } hovered)
+        { Send(SkillBindingRequest.Quick, slot, hovered); return; }
+        var ability = Quick(slot);
+        if (ability != CombatAbility.None && Available(ability)) { ClassCombatClient.QuickCast(world, slot, ability); }
+    }
+    public static void Send(SkillBindingRequest request, int slot = 0, CombatAbility ability = CombatAbility.None)
+    {
+        if (!ClassCombatClient.Enabled || slot is < 0 or >= SkillBindingProtocol.Slots) { return; }
+        var writer = new StackDataWriter(SkillBindingProtocol.RequestLength);
+        writer.WriteUInt8(0xBF); writer.WriteUInt16BE(SkillBindingProtocol.RequestLength); writer.WriteUInt16BE(SkillBindingProtocol.SubCommand);
+        writer.WriteUInt8(SkillBindingProtocol.Version); writer.WriteUInt8((byte)request); writer.WriteUInt32BE(++_sequence);
+        writer.WriteUInt8((byte)Class); writer.WriteUInt8((byte)slot); writer.WriteUInt8((byte)ability);
+        NetClient.Socket.Send(writer.BufferWritten); writer.Dispose();
+    }
+    public static void Use(int slot, CombatAbility ability, uint serial, ushort x, ushort y, sbyte z)
+    {
+        var writer = new StackDataWriter(SkillBindingProtocol.UseLength);
+        writer.WriteUInt8(0xBF); writer.WriteUInt16BE(SkillBindingProtocol.UseLength); writer.WriteUInt16BE(SkillBindingProtocol.SubCommand);
+        writer.WriteUInt8(SkillBindingProtocol.Version); writer.WriteUInt8((byte)SkillBindingRequest.Use); writer.WriteUInt32BE(++_sequence);
+        writer.WriteUInt8((byte)Class); writer.WriteUInt8((byte)slot); writer.WriteUInt8((byte)ability);
+        writer.WriteUInt32BE(serial); writer.WriteUInt16BE(x); writer.WriteUInt16BE(y); writer.WriteUInt8((byte)z);
+        NetClient.Socket.Send(writer.BufferWritten); writer.Dispose();
+    }
+    public static void Receive(World world, ref StackDataReader reader)
+    {
+        if (!world.InGame || reader.Remaining != SkillBindingProtocol.StateLength - 5 || reader.ReadUInt8() != SkillBindingProtocol.Version) { return; }
+        uint ack = reader.ReadUInt32BE();
+        if (unchecked((int)(ack - _sequence)) < 0) { return; }
+        var id = (DiabloClass)reader.ReadUInt8(); var left = (CombatAbility)reader.ReadUInt8(); var right = (CombatAbility)reader.ReadUInt8(); uint available = reader.ReadUInt32BE();
+        if (!DiabloClasses.TryFromWire((int)id, out _) || left > CombatAbility.Teleport || right > CombatAbility.Teleport) { return; }
+        Span<CombatAbility> quick = stackalloc CombatAbility[SkillBindingProtocol.Slots];
+        for (int i = 0; i < quick.Length; i++) { quick[i] = (CombatAbility)reader.ReadUInt8(); if (quick[i] > CombatAbility.Teleport) { return; } }
+        bool changed = !Ready || Class != id || Left != left || Right != right || _available != available;
+        for (int i = 0; i < quick.Length; i++) { changed |= _quick[i] != quick[i]; _quick[i] = quick[i]; }
+        Class = id; Left = left; Right = right; _available = available; Ready = true;
+        if (changed)
+        {
+            UIManager.GetGump<ClassSkillBarGump>()?.RequestUpdateContents();
+            UIManager.GetGump<ClassSkillsPanelGump>()?.RequestUpdateContents();
+        }
+    }
+}
diff --git a/src/ClassicUO.Client/Game/UI/Gumps/ClassSkillBarGump.cs b/src/ClassicUO.Client/Game/UI/Gumps/ClassSkillBarGump.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/UI/Gumps/ClassSkillBarGump.cs
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using System;
+using System.Linq;
+using ClassicUO.Configuration;
+using ClassicUO.Game.UI.Controls;
+using ClassicUO.Input;
+using Sanctuary;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal sealed class ClassSkillBarGump : Gump
+{
+    private sealed class SlotControl : Control { }
+    private int _step = 46;
+    public ClassSkillBarGump(World world) : base(world, 0, 0)
+    { CanMove = CanCloseWithRightClick = false; RequestUpdateContents(); }
+    public override void Update()
+    {
+        IsVisible = World.InGame && ClassCombatClient.Enabled && ClassSkillBindingsClient.Ready;
+        var profile = ProfileManager.CurrentProfile;
+        int step = Math.Clamp((profile.GameWindowSize.X - 196) / SkillBindingProtocol.Slots, 28, 46);
+        if (_step != step) { _step = step; RequestUpdateContents(); }
+        X = profile.GameWindowPosition.X + 8;
+        Y = Math.Max(0, profile.GameWindowPosition.Y + profile.GameWindowSize.Y - 67);
+        base.Update();
+    }
+    protected override void UpdateContents()
+    {
+        foreach (var child in Children.ToArray()) { child.Dispose(); }
+        Add(new AlphaBlendControl(0.9f) { Width = _step * SkillBindingProtocol.Slots + 4, Height = 56, AcceptMouseInput = false });
+        for (int slot = 0; slot < SkillBindingProtocol.Slots; slot++)
+        {
+            var ability = ClassSkillBindingsClient.Quick(slot);
+            bool available = ability != CombatAbility.None && ClassSkillBindingsClient.Available(ability);
+            var cell = new SlotControl { X = 4 + slot * _step, Y = 3, Width = _step - 2, Height = 49, AcceptMouseInput = true, WantUpdateSize = false };
+            cell.Add(new Line(0, 0, _step - 2, 49, available ? 0xFF504638 : 0xFF292929) { AcceptMouseInput = false });
+            cell.Add(new Label($"F{slot + 1}", true, 0x35) { X = 5, Y = 1, AcceptMouseInput = false });
+            string label = ability switch { CombatAbility.None => "—", CombatAbility.RaiseSkeleton => "Skel", CombatAbility.BasicAttack => "Atk", CombatAbility.Teeth when _step < 40 => "Tth", CombatAbility.Teleport => "Tele", _ => ability.ToString() };
+            cell.Add(new Label(label, true, available ? (ushort)0x481 : (ushort)0x3B2) { X = 3, Y = 22, AcceptMouseInput = false });
+            cell.SetTooltip(ability == CombatAbility.None ? $"F{slot + 1}: unassigned. Press S, hover a skill and press this key." :
+                $"F{slot + 1}: {CombatProtocol.Label(ability)}{(available ? "" : " (unavailable)")}. Aim over the world and press to quick cast. Press S to assign.");
+            Add(cell);
+        }
+        Width = _step * SkillBindingProtocol.Slots + 4; Height = 56;
+    }
+}
+
+internal sealed class ClassSkillsPanelGump : Gump
+{
+    public ClassSkillsPanelGump(World world) : base(world, 0, 0)
+    { X = 80; Y = 130; CanMove = true; CanCloseWithRightClick = false; RequestUpdateContents(); }
+    public CombatAbility? Hovered
+    {
+        get
+        {
+            foreach (var child in Children)
+            { if (child is SkillRow { MouseIsOver: true } row) { return row.Ability; } }
+            return null;
+        }
+    }
+    protected override void UpdateContents()
+    {
+        foreach (var child in Children.ToArray()) { child.Dispose(); }
+        var skills = Enum.GetValues<CombatAbility>().Where(a => a != CombatAbility.None && ClassSkillBindingsClient.Available(a)).Append(CombatAbility.None).ToArray();
+        int height = 118 + skills.Length * 38;
+        Add(new AlphaBlendControl(0.95f) { Width = 400, Height = height, AcceptMouseInput = false });
+        Add(new Label("Available skills — S to close", true, 0x35) { X = 14, Y = 10, AcceptMouseInput = false });
+        Add(new Label("Hover + F1–F12: quick cast", true, 0x481) { X = 14, Y = 36, AcceptMouseInput = false });
+        Add(new Label("Left / right click: bind mouse button", true, 0x481) { X = 14, Y = 57, AcceptMouseInput = false });
+        for (int i = 0; i < skills.Length; i++) { Add(new SkillRow(skills[i], 86 + i * 38)); }
+        Add(new Label($"L: {CombatProtocol.Label(ClassSkillBindingsClient.Left)}    R: {CombatProtocol.Label(ClassSkillBindingsClient.Right)}", true, 0x35)
+        { X = 14, Y = height - 25, AcceptMouseInput = false });
+        Width = 400; Height = height;
+    }
+    private sealed class SkillRow : Control
+    {
+        public CombatAbility Ability { get; }
+        public SkillRow(CombatAbility ability, int y)
+        {
+            Ability = ability; X = 14; Y = y; Width = 370; Height = 34; AcceptMouseInput = true; WantUpdateSize = false;
+            Add(new Line(0, 0, Width, Height, 0xFF504638) { AcceptMouseInput = false });
+            Add(new Label(ability == CombatAbility.None ? "Clear binding" : CombatProtocol.Label(ability), true, 0x481)
+            { X = 9, Y = 6, AcceptMouseInput = false });
+            SetTooltip(ability == CombatAbility.RaiseSkeleton ? "Aim at a corpse when quick casting. Hover and press F1–F12 to assign; click to bind a mouse button." :
+                "Hover and press F1–F12 to assign; left/right click to bind that mouse button.");
+        }
+        protected override void OnMouseUp(int x, int y, MouseButtonType button)
+        {
+            if (MouseIsOver && button is MouseButtonType.Left or MouseButtonType.Right)
+            {
+                ClassSkillBindingsClient.Send(button == MouseButtonType.Left ? SkillBindingRequest.Left : SkillBindingRequest.Right, ability: Ability);
+                Mouse.CancelDoubleClick = true;
+            }
+            base.OnMouseUp(x, y, button);
+        }
+    }
+}
