diff --git a/src/ClassicUO.Client/Game/UI/Gumps/ClassStatusPanel.cs b/src/ClassicUO.Client/Game/UI/Gumps/ClassStatusPanel.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/UI/Gumps/ClassStatusPanel.cs
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using System;
+using System.Collections.Generic;
+using ClassicUO.Assets;
+using ClassicUO.Game.UI.Controls;
+using ClassicUO.Input;
+using Sanctuary;
+
+namespace ClassicUO.Game.UI.Gumps;
+
+internal sealed class ClassStatusPanel : Control
+{
+    private readonly World _world;
+    private readonly List<(Label Label, Func<string> Text)> _values = new();
+    private readonly HitBox[] _attributes = new HitBox[4];
+    private readonly Label[] _pluses = new Label[4];
+    public ClassStatusPanel(World world)
+    {
+        _world = world;
+        AcceptMouseInput = false;
+        bool uop = Client.Game.UO.FileManager.Gumps.UseUOPGumps;
+        int statX = uop ? 80 : 88;
+        Value(90, 50, 420, () => world.Player.Name ?? string.Empty, TEXT_ALIGN_TYPE.TS_CENTER);
+        for (int i = 0; i < 4; i++)
+        {
+            int index = i, y = 70 + i * 28;
+            Value(statX, y + 7, 34, () => ClassStatsClient.Ready ? Get((StatField)index).ToString() : "...");
+            _pluses[i] = new Label("+", false, 0x35, font: 1) { X = uop ? 28 : 40, Y = y + 6 };
+            Add(_pluses[i]);
+            var hit = new HitBox(uop ? 28 : 40, y, uop ? 92 : 78, 24, alpha: 0.15f);
+            hit.MouseUp += (_, e) =>
+            {
+                if (e.Button == MouseButtonType.Left && !world.TargetManager.IsTargeting)
+                {
+                    ClassStatsClient.Spend((CharacterStat)index);
+                }
+            };
+            _attributes[i] = hit;
+            Add(hit);
+        }
+        // The legacy HCI artwork occupies the new Vitality cell.
+        Add(new Line(uop ? 42 : 52, 158, 29, 20, 0xFFB6B6B6));
+        Add(new Label("Vit", false, 0x386, font: 1) { X = uop ? 43 : 53, Y = 161 });
+        // Keep the click surface above the replacement icon.
+        _attributes[3].BringOnTop();
+        int healthX = uop ? 145 : 141;
+        Pair(healthX, 70, () => world.Player.Hits, () => world.Player.HitsMax);
+        Pair(healthX, 98, () => world.Player.Stamina, () => world.Player.StaminaMax);
+        Pair(healthX, 126, () => world.Player.Mana, () => world.Player.ManaMax);
+        Value(uop ? 150 : 146, 161, 42, () => Get(StatField.Defense).ToString());
+        Tip(124, 70, 69, 24, "Life / Maximum Life. Vitality and class level determine your life pool.");
+        Tip(124, 98, 69, 24, "Stamina / Maximum Stamina. Vitality and class level determine your stamina pool.");
+        Tip(124, 126, 69, 24, "Mana / Maximum Mana. Energy and class level determine your mana pool.");
+        Tip(124, 154, 69, 24, "Defense Rating. Reduces physical hit chance; disabled while running. Armor contributes defense separately from physical resistance.");
+        int middle = uop ? 240 : 220;
+        Value(middle, 77, 42, () => Get(StatField.Level).ToString());
+        Value(middle, 105, 42, () => world.Player.Luck.ToString());
+        Pair(middle - 10, 126, () => world.Player.Weight, () => world.Player.WeightMax);
+        Value(middle, 161, 42, () => Get(StatField.Points).ToString(), hue: 0x35);
+        Tip(uop ? 205 : 188, 70, 65, 24, "Character Level. Each level awards 5 attribute points and 1 talent point.");
+        Tip(uop ? 205 : 188, 98, 65, 24, "Luck. Existing UO equipment value; Diablo magic find is not implemented yet.");
+        Tip(uop ? 205 : 188, 126, 65, 24, "Carried Weight / Maximum Weight. Strength increases carrying capacity.");
+        Tip(uop ? 205 : 188, 154, 65, 24, "Unspent attribute points. Click a left-column attribute to spend one point. Earn 5 per level.");
+        int attackX = uop ? 320 : 280;
+        Value(attackX - 10, 77, 55, () => $"{Get(StatField.DamageMin)}-{Get(StatField.DamageMax)}");
+        Value(attackX, 105, 45, () => Get(StatField.AttackRating).ToString());
+        Value(attackX, 133, 45, () => $"{world.Player.Followers}/{world.Player.FollowersMax}");
+        Value(attackX, 161, 45, () => Get(StatField.Ias) + "%");
+        int attackHitX = uop ? 285 : 260;
+        Tip(attackHitX, 70, 69, 24, "Basic Attack Damage before target resistance. Uses weapon damage, Strength/Dexterity and equipment damage bonuses.");
+        Tip(attackHitX, 98, 69, 24, "Attack Rating. Dexterity grants 5 per point, with a class bonus. Physical attacks roll against enemy defense and level; spells do not.");
+        Tip(attackHitX, 126, 69, 24, "Followers / Maximum Followers. Summoning limits will be adapted when class summons are implemented.");
+        Tip(attackHitX, 154, 69, 24, "Increased Attack Speed (IAS). Equipment percentage; applies to attack animation breakpoints, not casting.");
+        if (uop)
+        {
+            Value(400, 77, 38, () => "--");
+            Value(400, 105, 38, () => "--");
+            Value(400, 133, 38, () => Get(StatField.Fcr) + "%");
+            Value(400, 161, 38, () => "--");
+            Tip(365, 70, 69, 24, "Reserved. Reagents are not used by class abilities.");
+            Tip(365, 98, 69, 24, "Reserved for future class combat bonuses.");
+            Tip(365, 126, 69, 24, "Faster Cast Rate (FCR). Equipment percentage; applies to casting breakpoints, not physical attacks.");
+            Tip(365, 154, 69, 24, "Faster Hit Recovery (FHR). Hit recovery is not implemented yet.");
+            Value(480, 161, 70, () => world.Player.Gold.ToString());
+            Tip(445, 154, 100, 24, "Gold carried in your backpack.");
+        }
+        else
+        {
+            Value(280, 105, 45, () => world.Player.Gold.ToString());
+        }
+        int resX = uop ? 480 : 360;
+        Value(resX, 74, 64, () => $"{world.Player.PhysicalResistance}/{world.Player.MaxPhysicResistence}");
+        Value(resX, 92, 64, () => $"{world.Player.FireResistance}/{world.Player.MaxFireResistence}");
+        Value(resX, 106, 64, () => $"{world.Player.ColdResistance}/{world.Player.MaxColdResistence}");
+        Value(resX, 120, 64, () => $"{world.Player.PoisonResistance}/{world.Player.MaxPoisonResistence}");
+        Value(resX, 134, 64, () => $"{world.Player.EnergyResistance}/{world.Player.MaxEnergyResistence}");
+        string[] resistances = ["Physical", "Fire", "Cold", "Poison", "Lightning"];
+        int[] resY = [70, 88, 102, 116, 130];
+        for (int i = 0; i < resistances.Length; i++)
+        {
+            Tip(uop ? 445 : 334, resY[i], 100, 14,
+                resistances[i] + " Resistance / Maximum (%). Reduces incoming damage of this type.");
+        }
+        Refresh();
+    }
+    private static int Get(StatField field) => ClassStatsClient.Get(field);
+    private void Value(int x, int y, int width, Func<string> text,
+        TEXT_ALIGN_TYPE align = TEXT_ALIGN_TYPE.TS_LEFT, ushort hue = 0x386)
+    {
+        var label = new Label(text(), false, hue, width, font: 1, align: align) { X = x, Y = y };
+        Add(label);
+        _values.Add((label, text));
+    }
+    private void Pair(int x, int y, Func<int> current, Func<int> maximum)
+    {
+        Value(x, y, 40, () => current().ToString(), TEXT_ALIGN_TYPE.TS_CENTER);
+        Value(x, y + 13, 40, () => maximum().ToString(), TEXT_ALIGN_TYPE.TS_CENTER);
+        Add(new Line(x, y + 12, 40, 1, 0xFF383838));
+    }
+    private void Tip(int x, int y, int width, int height, string text) =>
+        Add(new HitBox(x, y, width, height, text, 0) { CanMove = true });
+    private static string Quarter(int value) => (value / 4.0).ToString("0.##");
+    public void Refresh()
+    {
+        foreach (var (label, text) in _values)
+        {
+            label.Text = text();
+        }
+        string[] tips =
+        [
+            "Strength: weapon damage and equipment requirements. Also increases carrying capacity.",
+            "Dexterity: +5 base Attack Rating per point and +1 base Defense per 4 points. Also improves bow, dagger and throwing damage.",
+            $"Energy: +{Quarter(Get(StatField.ManaPerEnergy4))} Mana per point for your class.",
+            $"Vitality: +{Quarter(Get(StatField.LifePerVitality4))} Life and +{Quarter(Get(StatField.StaminaPerVitality4))} Stamina per point for your class."
+        ];
+        int points = Get(StatField.Points);
+        for (int i = 0; i < 4; i++)
+        {
+            _pluses[i].IsVisible = ClassStatsClient.Ready && points > 0 && !_world.Player.IsDead;
+            _attributes[i].SetTooltip(tips[i] + (points > 0 ? $"\nClick to add 1 point. {points} available." : "\nNo unspent attribute points. Gain a level to earn 5."));
+        }
+    }
+}
