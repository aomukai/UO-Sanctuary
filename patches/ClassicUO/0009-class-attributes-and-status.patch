diff --git a/src/ClassicUO.Client/Game/ClassStatsClient.cs b/src/ClassicUO.Client/Game/ClassStatsClient.cs
new file mode 100644
--- /dev/null
+++ b/src/ClassicUO.Client/Game/ClassStatsClient.cs
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: BSD-2-Clause
+using ClassicUO.IO;
+using ClassicUO.Network;
+using Sanctuary;
+
+namespace ClassicUO.Game;
+
+internal static class ClassStatsClient
+{
+    private static int[] _values = new int[StatProtocol.Values];
+    private static uint _sequence, _nextPoll;
+    public static bool Ready { get; private set; }
+    public static int Get(StatField field) => _values[(int)field];
+    public static void Reset()
+    {
+        Ready = false;
+        _sequence = 0;
+        _nextPoll = Time.Ticks;
+        _values = new int[StatProtocol.Values];
+    }
+    public static void Update()
+    {
+        if (ClassCombatClient.Enabled && unchecked((int)(Time.Ticks - _nextPoll)) >= 0)
+        {
+            _nextPoll = Time.Ticks + StatProtocol.PollMs;
+            Send(0);
+        }
+    }
+    public static void Spend(CharacterStat stat)
+    {
+        if (Ready && Get(StatField.Points) > 0 && (byte)stat <= 3)
+        {
+            Send((byte)((byte)stat + 1));
+        }
+    }
+    public static void Receive(World world, ref StackDataReader reader)
+    {
+        if (!world.InGame || reader.Remaining != 1 + StatProtocol.Values * 4 || reader.ReadUInt8() != StatProtocol.Version)
+        {
+            return;
+        }
+        var values = new int[StatProtocol.Values];
+        for (int i = 0; i < values.Length; i++)
+        {
+            values[i] = reader.ReadInt32BE();
+            if (values[i] < 0 && i != (int)StatField.Defense)
+            {
+                return;
+            }
+        }
+        if (!DiabloClasses.TryFromWire(values[(int)StatField.Class], out _)
+            || values[(int)StatField.Level] is < 1 or > 99 || values[(int)StatField.Points] > 490)
+        {
+            return;
+        }
+        _values = values;
+        Ready = true;
+    }
+    private static void Send(byte request)
+    {
+        var writer = new StackDataWriter(11);
+        writer.WriteUInt8(0xBF);
+        writer.WriteUInt16BE(11);
+        writer.WriteUInt16BE(StatProtocol.SubCommand);
+        writer.WriteUInt8(StatProtocol.Version);
+        writer.WriteUInt8(request);
+        writer.WriteUInt32BE(++_sequence);
+        NetClient.Socket.Send(writer.BufferWritten);
+        writer.Dispose();
+    }
+}
