+        private void DrawGroundRing(UltimaBatcher2D batcher, int x, int y, Vector3 hue, float depth)
+        {
+            ref readonly var art = ref Client.Game.UO.Arts.GetArt(AnimationGraphic);
+            if (art.Texture == null)
+            {
+                return;
+            }
+
+            const int pixelsPerDepthTile = 22;
+            const int stripHeight = 8;
+            // The packed ground pivot leaves 116 px below center for the front of the ring.
+            int pivot = art.UV.Height - 116;
+            int left = x - art.UV.Width / 2;
+            for (int row = 0; row < art.UV.Height; row += stripHeight)
+            {
+                int height = Math.Min(stripHeight, art.UV.Height - row);
+                int relativeY = row - pivot;
+                // Place each strip above its own ground row so forward terrain does not erase the ring.
+                float surfaceDepth = depth + (relativeY + height / 2f) / pixelsPerDepthTile + 1.1f;
+                batcher.Draw(art.Texture, new Rectangle(left, y + relativeY, art.UV.Width, height),
+                    new Rectangle(art.UV.X, art.UV.Y + row, art.UV.Width, height), hue, 0f,
+                    Vector2.Zero, SpriteEffects.None, surfaceDepth);
+            }
+        }
