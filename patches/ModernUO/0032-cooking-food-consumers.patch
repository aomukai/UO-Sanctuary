+using System;
+using Server.Engines.Harvest;
+using Server.Items;
+
+namespace Server.Mobiles;
+
+public static class ClassFoodHooks
+{
+    public static Func<Mobile, bool> NoHunger { get; set; }
+    public static Func<PlayerMobile, int> CarryCapacity { get; set; }
+    public static Func<Mobile, HarvestDefinition, TimeSpan, TimeSpan> HarvestDuration { get; set; }
+    public static Action<Mobile, HarvestDefinition, Item> Harvested { get; set; }
+    public static Func<BaseCreature, bool> ExtraCarvable { get; set; }
+    public static Func<Mobile, Corpse, int> CarveBonus { get; set; }
+    public static Action<Mobile, BaseCreature, Corpse> ExtraCarved { get; set; }
+    public static Func<BaseCreature, Mobile, bool> CanAcquire { get; set; }
+    public static Func<BaseCreature, long, long> AcquireDeadline { get; set; }
+}
