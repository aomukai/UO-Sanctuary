diff --git a/Projects/UOContent/Engines/Craft/Core/MaterialProcessHooks.cs b/Projects/UOContent/Engines/Craft/Core/MaterialProcessHooks.cs
new file mode 100644
--- /dev/null
+++ b/Projects/UOContent/Engines/Craft/Core/MaterialProcessHooks.cs
@@ -0,0 +1,18 @@
+using System;
+using Server.Items;
+
+namespace Server.Engines.Craft;
+
+public static class MaterialProcessHooks
+{
+    public static Func<Item, double?> Weight { get; set; }
+    public static Action<Item> Normalize { get; set; }
+    public static Func<Mobile, Item, Item, int, Item, bool?> Cut { get; set; }
+    public static Func<Mobile, BaseOre, object, double, double, bool> Smelt { get; set; }
+    public static Func<Mobile, BaseOre, BaseOre, bool> Combine { get; set; }
+    public static Func<Mobile, Item, ISpinningWheel, bool> Spin { get; set; }
+    public static Func<Mobile, BaseClothMaterial, ILoom, Item, bool> Weave { get; set; }
+    public static Func<Type, bool> StockAllowed { get; set; }
+    public static Func<Item, bool> ResaleAllowed { get; set; }
+    public static Func<Mobile, SkillName, int?> GainCap { get; set; }
+}
