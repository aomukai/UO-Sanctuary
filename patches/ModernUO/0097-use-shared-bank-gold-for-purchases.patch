+++ b/Projects/UOContent/Mobiles/Townfolk/Banker.cs
@@ -23,6 +23,67 @@
 
     public override NpcGuild NpcGuild => NpcGuild.MerchantsGuild;
 
+    public new static void Configure()
+    {
+        AccountGold.ConvertBankContents = ConvertBankContents;
+        EventSink.ServerStarted += () => Timer.DelayCall(MigrateBankBalances);
+    }
+
+    private static void MigrateBankBalances()
+    {
+        if (!AccountGold.Enabled || !AccountGold.ConvertOnBank)
+        {
+            return;
+        }
+
+        foreach (var account in Accounts.GetAccounts())
+        {
+            for (int slot = 0; slot < account.Length; slot++)
+            {
+                if (account[slot]?.FindBankNoCreate() is { } bank)
+                {
+                    ConvertBankContents(account, bank);
+                }
+            }
+        }
+    }
+
+    private static void ConvertBankContents(IAccount account, Container container)
+    {
+        using var deposits = PooledRefList<Item>.Create();
+        foreach (var gold in container.FindItemsByType<Gold>())
+        {
+            deposits.Add(gold);
+        }
+        foreach (var check in container.FindItemsByType<BankCheck>())
+        {
+            deposits.Add(check);
+        }
+
+        foreach (var item in deposits)
+        {
+            if (account.DepositGold(item is Gold gold ? gold.Amount : ((BankCheck)item).Worth))
+            {
+                item.Delete();
+            }
+        }
+    }
+
+    public static bool PayPurchase(Mobile buyer, int amount, out bool fromBank)
+    {
+        fromBank = false;
+        if (amount < 0)
+        {
+            return false;
+        }
+        if (amount == 0 || buyer.Backpack?.ConsumeTotal(typeof(Gold), amount) == true)
+        {
+            return true;
+        }
+
+        return fromBank = Withdraw(buyer, amount);
+    }
+
