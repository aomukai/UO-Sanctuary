+// SPDX-License-Identifier: GPL-3.0-or-later
+using System;
+using Server.Collections;
+using Server.ContextMenus;
+using Server.Items;
+
+namespace Server.Mobiles;
+
+public delegate bool MountContextEntries(BaseCreature mount, Mobile from, ref PooledRefList<ContextMenuEntry> entries);
+
+public static class ClassMountHooks
+{
+    public static Func<BaseCreature, bool> Managed { get; set; }
+    public static Func<Mobile, bool> BlockTravel { get; set; }
+    public static Func<Mobile, BaseMount, bool> CanRide { get; set; }
+    public static Action<BaseMount, Mobile, Mobile> RiderChanged { get; set; }
+    public static Action<BaseMount> BeforeDeath { get; set; }
+    public static MountContextEntries ContextEntries { get; set; }
+    public static Func<BaseCreature, Mobile, bool> Feed { get; set; }
+    public static Func<Mobile, bool> CanUseTaming { get; set; }
+    public static Func<Mobile, BaseCreature, bool> CanTame { get; set; }
+    public static Func<Mobile, BaseCreature, double> TameSkill { get; set; }
+    public static Func<Mobile, BaseCreature, bool> Tamed { get; set; }
+    public static Func<Mobile, Corpse, bool> CorpseInteraction { get; set; }
+    public static Func<Mobile, BaseCreature, bool> StableInteraction { get; set; }
+}
