diff --git a/Projects/Server/Mobiles/Notoriety.cs b/Projects/Server/Mobiles/Notoriety.cs
--- a/Projects/Server/Mobiles/Notoriety.cs
+++ b/Projects/Server/Mobiles/Notoriety.cs
@@ -1,3 +1,6 @@
+using System;
+using Server.Network;
+
 namespace Server;
 
 public delegate int NotorietyHandler(Mobile source, Mobile target);
@@ -13,6 +16,8 @@
     public const int Invulnerable = 7;
 
     public static NotorietyHandler Handler { get; set; }
+    public static NotorietyHandler NameStyleHandler { get; set; }
+    public static Action<NetState, Mobile, Mobile> SendNameStyle { get; set; }
 
     public static int[] Hues { get; set; } =
     {
@@ -29,4 +34,16 @@
     public static int GetHue(int noto) => noto < 0 || noto >= Hues.Length ? 0 : Hues[noto];
 
     public static int Compute(Mobile source, Mobile target) => Handler?.Invoke(source, target) ?? CanBeAttacked;
+
+    public static int GetNameHue(Mobile source, Mobile target)
+    {
+        int style = NameStyleHandler?.Invoke(source, target) ?? 0;
+        if (style != 0)
+        {
+            return GetHue(style);
+        }
+
+        return target.NameHue != -1 ? target.NameHue : target.AccessLevel > AccessLevel.Player
+            ? 11 : GetHue(Compute(source, target));
+    }
 }
