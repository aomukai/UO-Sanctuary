diff --git a/Projects/Server/Items/ItemOrigin.cs b/Projects/Server/Items/ItemOrigin.cs
new file mode 100644
--- /dev/null
+++ b/Projects/Server/Items/ItemOrigin.cs
@@ -0,0 +1,36 @@
+using System;
+
+namespace Server;
+
+public enum ItemOrigin : byte
+{
+    Drop = 0,
+    Vendor = 1,
+    Crafted = 2
+}
+
+// Item construction and this synchronous factory run only on the game loop.
+public static class ItemOrigins
+{
+    internal static ItemOrigin Current { get; private set; }
+
+    public static T Create<T>(ItemOrigin origin, Func<T> factory)
+    {
+        if (!Enum.IsDefined(origin))
+        {
+            throw new ArgumentOutOfRangeException(nameof(origin));
+        }
+
+        ArgumentNullException.ThrowIfNull(factory);
+        var previous = Current;
+        Current = origin;
+        try
+        {
+            return factory();
+        }
+        finally
+        {
+            Current = previous;
+        }
+    }
+}
