+++ b/Projects/UOContent/Multis/Houses/HousingContentHooks.cs
@@ -0,0 +1,22 @@
+using System;
+
+namespace Server.Multis;
+
+public static class HousingContentHooks
+{
+    public static Func<Mobile, bool> AcquisitionAllowed { get; set; }
+    public static Func<Mobile, BaseHouse, bool> DemolitionRequested { get; set; }
+    public static bool AccountOwners { get; set; }
+    public static Action<BaseHouse, Mobile> OwnershipChanged { get; set; }
+
+    public static bool CanAcquire(Mobile from)
+    {
+        if (AcquisitionAllowed?.Invoke(from) != false)
+        {
+            return true;
+        }
+
+        from.SendMessage("Someone on your account must receive civic recognition before acquiring a home.");
+        return false;
+    }
+}
