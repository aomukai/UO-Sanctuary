@@ -64,6 +64,42 @@ public Spawner(string spawnedName) : base(spawnedName)
 
     public override Region Region => Region.Find(Location, Map);
 
+    private bool HasUnboundedHeight => _spawnBounds.Start.Z == -128 && _spawnBounds.Depth == 256;
+
+    internal void AnchorToPlacedFloor()
+    {
+        if (HasUnboundedHeight && IsHomeRangeStyle)
+        {
+            SetSpawnFloor();
+        }
+    }
+
+    private void SetSpawnFloor() => SpawnBounds = new Rectangle3D(
+        _spawnBounds.Start.X, _spawnBounds.Start.Y, Z, _spawnBounds.Width, _spawnBounds.Height, 1
+    );
+
+    public override void OnLocationChange(Point3D oldLocation)
+    {
+        bool followFloor = Z != oldLocation.Z && _spawnBounds.Depth == 1 && _spawnBounds.Start.Z == oldLocation.Z
+            && IsHomeRangeStyleAt(oldLocation);
+        base.OnLocationChange(oldLocation);
+        if (followFloor)
+        {
+            SetSpawnFloor();
+        }
+    }
+
+    public override Point3D GetSpawnPosition(ISpawnable spawned, Map map)
+    {
+        // Older point spawners could retain the default all-floor Z range.
+        if (spawned is Mobile && _spawnBounds.Width == 1 && HasUnboundedHeight && IsHomeRangeStyle)
+        {
+            return Location;
+        }
+
+        return base.GetSpawnPosition(spawned, map);
+    }
+
     protected override bool SupportsSpiralScan => _useSpiralScan;
 
     protected override Rectangle3D GetBoundsForSpawnAttempt() => SpawnBounds;
