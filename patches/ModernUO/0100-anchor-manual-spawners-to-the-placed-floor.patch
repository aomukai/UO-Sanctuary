diff --git a/Projects/UOContent/Engines/Spawners/Spawner.cs b/Projects/UOContent/Engines/Spawners/Spawner.cs
index 184558e..b9c6acf 100644
--- a/Projects/UOContent/Engines/Spawners/Spawner.cs
