+        internal static void DropCarvedHides(Mobile from, Corpse corpse, int amount, HideType hideType, int foodBonus,
+            bool cutLeather = false)
+        {
+            if (Core.ML && from.Race == Race.Human)
+            {
+                amount = (int)Math.Ceiling(amount * 1.1);
+            }
+
+            if (corpse.Map == Map.Felucca)
+            {
+                amount *= 2;
+            }
+
+            amount += foodBonus;
+            Item hides = (hideType, cutLeather) switch
+            {
+                (HideType.Regular, true) => new Leather(amount),
+                (HideType.Spined, true) => new SpinedLeather(amount),
+                (HideType.Horned, true) => new HornedLeather(amount),
+                (HideType.Barbed, true) => new BarbedLeather(amount),
+                (HideType.Regular, false) => new Hides(amount),
+                (HideType.Spined, false) => new SpinedHides(amount),
+                (HideType.Horned, false) => new HornedHides(amount),
+                (HideType.Barbed, false) => new BarbedHides(amount),
+                _ => null
+            };
+
+            if (hides == null)
+            {
+                return;
+            }
+
+            if (cutLeather && from.PlaceInBackpack(hides))
+            {
+                from.SendLocalizedMessage(1073555); // You skin it and place the cut-up hides in your backpack.
+            }
+            else
+            {
+                corpse.DropItem(hides);
+                from.SendLocalizedMessage(500471); // You skin it, and the hides are now in the corpse.
+            }
+        }
+
