@@ -0,0 +1,10 @@
+using System;
+
+namespace Server;
+
+// Optional content-owned state follows native item copies without an engine dependency on content.
+public static class ItemStateHooks
+{
+    public static Action<Item, Item> Copied { get; set; }
+    public static Func<Item, Item, bool> CanStack { get; set; }
+}
