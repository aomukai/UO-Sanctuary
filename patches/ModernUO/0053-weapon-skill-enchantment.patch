--- /dev/null
+++ b/Projects/UOContent/Mobiles/ClassSkillLifecycle.cs
@@ -0,0 +1,10 @@
+using ModernUO.CodeGeneratedEvents;
+
+namespace Server.Mobiles;
+
+public static class ClassSkillLifecycle
+{
+    [OnEvent(nameof(CreatureEvents.CreatureDeathEvent))]
+    [OnEvent(nameof(CreatureEvents.CreatureDeletedEvent))]
+    public static void EndEffects(BaseCreature creature) => ClassCombatHooks.CreatureEffectsEnded?.Invoke(creature);
+}
