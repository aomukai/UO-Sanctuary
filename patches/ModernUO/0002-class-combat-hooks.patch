diff --git a/Projects/UOContent/Mobiles/ClassCombatHooks.cs b/Projects/UOContent/Mobiles/ClassCombatHooks.cs
new file mode 100644
--- /dev/null
+++ b/Projects/UOContent/Mobiles/ClassCombatHooks.cs
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+using System;
+using Server.Items;
+namespace Server.Mobiles;
+// A content assembly can own player attacks while NPC combat remains independent.
+public static class ClassCombatHooks
+{
+    public static Action<Dagger, IPropertyList> DaggerProperties { get; set; }
+    public static Action<PlayerMobile, Direction> Moved { get; set; }
+    public static Func<PlayerMobile, bool> DefenseSuppressed { get; set; }
+    public static Func<PlayerMobile, bool> Enabled { get; set; }
+    public static Func<PlayerMobile, SkillName, bool> SkillGainAllowed { get; set; }
+    public static Action<PlayerMobile, Mobile> AttackRequested { get; set; }
+}
