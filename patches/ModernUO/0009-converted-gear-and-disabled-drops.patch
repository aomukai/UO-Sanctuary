+    public static Func<Item, IPropertyList, bool> Properties { get; set; }
+    public static Func<BaseAttributes, int, int?> Attribute { get; set; }
+    public static Func<Mobile, AosAttribute, int?> MobileAttribute { get; set; }
+    public static Func<PlayerMobile, ResistanceType, int?> Resistance { get; set; }
+}
