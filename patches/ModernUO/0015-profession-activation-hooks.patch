diff --git a/Projects/UOContent/Engines/Craft/Core/TradeSkillHooks.cs b/Projects/UOContent/Engines/Craft/Core/TradeSkillHooks.cs
new file mode 100644
--- /dev/null
+++ b/Projects/UOContent/Engines/Craft/Core/TradeSkillHooks.cs
@@ -0,0 +1,24 @@
+using System;
+using Server.Items;
+using Server.Mobiles;
+
+namespace Server.Engines.Craft;
+
+public delegate BaseCreature.TeachResult? TradeTraining(BaseCreature trainer, SkillName skill, Mobile student,
+    int payment, ref int price, bool apply);
+
+public static class TradeSkillHooks
+{
+    public static Func<Mobile, SkillName, Item, bool, bool> ActionAllowed { get; set; }
+    public static Func<Mobile, BaseTool, bool> ToolUsed { get; set; }
+    public static Func<Mobile, SkillName, Type, BaseTool, bool, bool> RecipeAllowed { get; set; }
+    public static Func<Mobile, bool> IndependentSkills { get; set; }
+    public static Func<Mobile, SkillName, bool> TeachingAllowed { get; set; }
+    public static TradeTraining Training { get; set; }
+    public static Func<BaseCreature, Mobile, Gold, bool?> TrainingPayment { get; set; }
+    public static bool Check(Mobile from, SkillName skill, Item source, bool prompt = false) =>
+        ActionAllowed?.Invoke(from, skill, source, prompt) != false;
+    public static bool Independent(Mobile from) => IndependentSkills?.Invoke(from) == true;
+    public static bool CheckRecipe(Mobile from, CraftSystem system, CraftItem recipe, BaseTool tool, bool prompt = false) =>
+        RecipeAllowed?.Invoke(from, system.MainSkill, recipe.ItemType, tool, prompt) != false;
+}
