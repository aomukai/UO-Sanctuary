<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ModernUODistribution>$(MSBuildThisFileDirectory)../../upstream/ModernUO/Distribution</ModernUODistribution>
    <SanctuaryContentAssembly Condition="'$(SanctuaryContentAssembly)' == ''">$(MSBuildThisFileDirectory)../../.local/content/Sanctuary.Content.dll</SanctuaryContentAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Server" HintPath="$(ModernUODistribution)/Server.dll" Private="false" />
    <Reference Include="UOContent" HintPath="$(ModernUODistribution)/Assemblies/UOContent.dll" Private="false" />
    <Reference Include="Logger" HintPath="$(ModernUODistribution)/Logger.dll" Private="false" />
    <Reference Include="Sanctuary.Content" HintPath="$(SanctuaryContentAssembly)" Private="false" />
  </ItemGroup>
</Project>
